         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP752 - 200 mA, Ultra-Low Quiescent Current, IQ 12 Î¼A, Ultra-Low Noise, Low Dropout Regulator </rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Noise sensitive RF applications such as Power Amplifiers in satellite radios, infotainment equipment, and precision instrumentation require very clean power supplies. The NCP752 is 200 mA LDO that provides the engineer with a very stable, accurate voltage with ultra low noise and very high Power Supply Rejection Ratio (PSRR) suitable for RF applications.</rdf:li>
            </rdf:Alt>
         </dc:description>
