         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>TE Connectivity</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">TE Connectivity (TE)â€™s Miniature Power PCB Relays RYII &amp; RYII reflow is general purpose relay designed for various types of loads (e.g., resistive, inductive) with low component height. The relay is designed as 1 pole 8A with different contact variants: 1 form C (CO) or 1 form A (NO) or 1 form B (NC) contact.</rdf:li>
            </rdf:Alt>
         </dc:description>
