         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NDC7002N - Field Effect Transistor - Dual, N-Channel, Enhancement Mode</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">These dual N-Channel enhancement mode power field effect transistors are produced using onsemi's proprietary, high cell density, DMOS technology. This very high density process has been designed to minimize on-state resistance, provide rugged andâ€‰reliable performance and fast switching. These devices is particularly suited for low voltage applications requiring a low current high side switch.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:6dbfa40b-d590-4045-b1b5-db71f51ce4ec</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:c91f9a86-fc74-4ead-82d7-7d767532e55f</xmpMM:InstanceID>
      </rdf:Description>
