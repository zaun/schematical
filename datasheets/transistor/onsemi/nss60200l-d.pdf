         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NSS60200L - Low VCE(sat) Transistor, PNP, -60 V, 2.0 A</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">onsemiâ€™s e2PowerEdge family of low VCE(sat) transistors are&#xA;miniature surface mount devices featuring ultra low saturation voltage&#xA;(VCE(sat)) and high current gain capability. These are designed for use&#xA;in low voltage, high speed switching applications where affordable&#xA;efficient energy control is important.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 25.0 (Windows)</pdf:Producer>
