         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">FDS8896 - MOSFET - N-Channel, POWERTRENCH 30 V, 15 A, 6.0 mOhm</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This N-Channel MOSFET has been designed specifically to&#xD;&#xA;improve the overall efficiency of DC/DC converters using either&#xD;&#xA;synchronous or conventional switching PWM controllers. It has been&#xD;&#xA;optimized for low gate charge, low RDS(on) and fast switching speed.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2026-01-15T14:38:21-07:00</xmp:ModifyDate>
