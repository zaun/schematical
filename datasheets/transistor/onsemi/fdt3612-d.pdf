         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">FDT3612 - MOSFET â€“ N-Channel, POWERTRENCHÂ® 100 V</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This Nâˆ’Channel MOSFET has been designed specifically&#xA;to improve the overall efficiency of DC/DC converters using either&#xA;synchronous or conventional switching PWM controllers.&#xA;These MOSFETs feature faster switching and lower gate charge&#xA;than other MOSFETs with comparable RDS(ON) specifications.&#xA;The result is a MOSFET that is easy and safer to drive (even at very&#xA;high frequencies), and DC/DC power supply designs with higher&#xA;overall efficiency.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:1c5bd483-2287-4d29-9fa2-b47e5560d7bb</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:94654044-5289-4959-b27a-1328b3a50fb6</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
