         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">UF3C170400K3S - Silicon Carbide (SiC) Cascode JFET - EliteSiC, Power N-Channel, TO247-3, 1700 V, 410 mohm</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This SiC FET device is based on a unique â€˜cascodeâ€™ circuit configuration, in which a normally-on SiC JFET is co-packaged with a Si MOSFET to produce a normally-off SiC FET device. The deviceâ€™s standard gate-drive characteristics allows for a true â€œdrop-in replacementâ€ to Si IGBTs, Si FETs, SiC MOSFETs or Si super-junction devices. Available in the TO247-3 package, this device exhibits ultra-low gate charge and exceptional reverse recovery characteristics, making it ideal for switching inductive loads, and any application requiring standard gate drive.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 25.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmpMM:DocumentID>uuid:22aaa56f-e822-4092-b96f-df6c9dda9cfd</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:529bbfc2-20c9-4b7b-b886-c68f2317ad5f</xmpMM:InstanceID>
      </rdf:Description>
