         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NSS40302P - Complementary 40 V, 6.0 A, Low VCE(sat) Transistor</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">onsemiâ€™s e2PowerEdge family of low VCE(sat) transistors are&#xA;surface mount devices featuring ultra low saturation voltage (VCE(sat))&#xA;and high current gain capability. These are designed for use in low&#xA;voltage, high speed switching applications where affordable efficient&#xA;energy control is important.</rdf:li>
            </rdf:Alt>
         </dc:description>
