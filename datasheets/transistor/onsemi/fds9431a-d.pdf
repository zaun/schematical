         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">FDS9431A - MOSFET âˆ’ Specified,    P-Channel, POWERTRENCH 2.5 V</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This P-Channel 2.5 V specified MOSFET is produced using onsemi&#xA;proprietary, high cell density, DMOS technology. This very high&#xA;density process has been especially tailored to minimize onstate&#xA;resistance and yet maintain superior switching performance.</rdf:li>
            </rdf:Alt>
         </dc:description>
