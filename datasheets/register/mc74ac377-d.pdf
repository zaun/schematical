<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 9.1-c001 79.675d0f7, 2023/06/11-19:21:16        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2024-02-22T13:04:31-07:00</xmp:ModifyDate>
         <xmp:CreateDate>2024-02-22T12:57:11-07:00</xmp:CreateDate>
         <xmp:MetadataDate>2024-02-22T13:04:31-07:00</xmp:MetadataDate>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MC74AC377 - Octal D Flip Flop with Clock Enable</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The MC74AC377/74ACT377 has eight edge-triggered, D-type&#xA;flip-flops with individual D inputs and Q outputs. The common&#xA;buffered Clock (CP) input loads all flip-flops simultaneously, when&#xA;the Clock Enable (CE) is LOW. The register is fully edge-triggered.&#xA;The state of each D input, one setup time before the LOW-to-HIGH&#xA;clock transition, is transferred to the corresponding flip-flopâ€™s Q&#xA;output. The CE input must be stable only one setup time prior to the&#xA;LOW-to-HIGH clock transition for predictable operation.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 23.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmpMM:DocumentID>uuid:f3f3f34e-291c-4b34-999b-d5de76a64144</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:91e3693d-b6e9-4831-99f5-4ebced9ab5f4</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                           
