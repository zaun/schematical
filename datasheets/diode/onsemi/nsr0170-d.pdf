         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NSR0170 - Schottky Barrier Diode</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Schottky barrier diodes are optimized for very low forward voltage drop and low leakage current making them ideal devices to be used in a wide range of dcâ€dc converter, clamping and protection applications. NSR0170 in SODâ€323, SODâ€923 and X2DFNW2 miniature packages enable designers to meet the challenging task of achieving higher efficiency while meeting reduced PCB space requirements.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:747ff5d9-87c1-4eaf-8bfe-32c1b8a31648</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:0f2d7a28-6705-4799-961d-e1c6f1dfb76c</xmpMM:InstanceID>
      </rdf:Description>
