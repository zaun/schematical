         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MMSZxxxET1G Series, SZMMSZxxxET1G Series - Zener Voltage Regulators</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Three complete series of Zener diodes are offered in the convenient,&#xD;&#xA;surface mount plastic SOD-123 package. These devices provide a&#xD;&#xA;convenient alternative to the leadless 34-package style.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:ca224cb1-3a09-4da5-baba-e4378d21619e</xmpMM:DocumentID>
