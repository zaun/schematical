         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MBD301 - Silicon Hot-Carrier Detector and Switching Diodes, 30 Volts</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">These devices are designed primarily for high-efficiency UHF and&#xA;VHF detector applications. They are readily adaptable to many other&#xA;fast switching RF and digital applications. They are supplied in an&#xA;inexpensive plastic package for low-cost, high-volume consumer&#xA;and industrial/commercial requirements. They are also available in a&#xA;Surface Mount package.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmp:CreateDate>2026-10-06T14:31:18-07:00</xmp:CreateDate>
