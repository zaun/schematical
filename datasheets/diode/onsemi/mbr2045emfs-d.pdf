         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MBR2045EMFS - Switch-mode Power Rectifiers</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">These state-of-the-art devices have the following features:&#xA;Features&#xA;â€¢â€‡Low Power Loss / High Efficiency&#xA;â€¢â€‡New Package Provides Capability of Inspection and Probe After Board Mounting&#xA;â€¢â€‡Guardring for Stress Protection&#xA;â€¢â€‡Low Forward Voltage Drop&#xA;â€¢â€‡150Â°C Operating Junction Temperature&#xA;â€¢â€‡Wettable Flacks Option Available&#xA;â€¢â€‡NRV Prefix for Automotive and Other Applications Requiring Unique Site and Control Change Requirements; AEC-Q101 Qualified and PPAP Capable&#xA;â€¢â€‡These are Pb-Free and Halide-Free Devices</rdf:li>
            </rdf:Alt>
         </dc:description>
