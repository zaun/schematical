         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MBRD1035CTL - Switchâ€mode Schottky Power Rectifier</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The MBRD1035CTLâ€‰employs the Schottky Barrier principle in a large area metalÂ­toÂ­silicon power diode. State of the art geometry features epitaxial construction with oxide passivation and metal overlay contact. Ideally suited for low voltage, high frequency switching power supplies, free wheeling diode and polarity protection diodes.</rdf:li>
            </rdf:Alt>
         </dc:description>
