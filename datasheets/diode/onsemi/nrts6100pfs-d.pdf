         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NRTS6100PFS - Schottky Barrier Rectifier, Trenchâ€based, High Performance</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This Trench Schottky rectifier is a high performance device in a TOâ€277 package. The lower forward voltage, less leakage current, and small junction capacitance are suitable to high switching frequency high density DC to DC conversion applications. It offers higher avalanche energy capability for Oring or reverse protection applications. The TOâ€277 package provides excellent thermal performance, less land area of board space, and a low profile.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:4d5b97bb-26d9-43be-9c01-9134e547178c</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:2411be1e-1cca-468d-9330-c2e7d4ca459c</xmpMM:InstanceID>
      </rdf:Description>
