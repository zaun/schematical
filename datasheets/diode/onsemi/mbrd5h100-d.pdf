         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MBRD5H100 - Switchâ€mode Schottky Power Rectifier</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This series of Power Rectifiers employs the Schottky Barrier principle in a large metalÂ­toÂ­silicon power diode. StateÂ­ofÂ­theÂ­art geometry features epitaxial construction with oxide passivation and metal overlay contact. Ideally suited for use in low voltage, high frequency switching power supplies, free wheeling diodes, and polarity protection diodes.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 25.0 (Windows)</pdf:Producer>
