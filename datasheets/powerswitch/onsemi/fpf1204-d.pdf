         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">FPF1204 - IntelliMAXâ„¢ Ultra-Small, Slew-Rate-Controlled Load Switch</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The FPF1204 is an ultraâˆ’small integrated IntelliMAX load switch&#xA;with integrated Pâˆ’channel switch and analog control features.&#xA;Integrated slewâˆ’rate control prevents inrush current and the resulting&#xA;excessive voltage drop on the power rail. The input voltage range&#xA;operates from 1.2 V to 5.5 V to provide powerâˆ’disconnect capability&#xA;for postâˆ’regulated power rails in portable and consumer products. The&#xA;low shutâˆ’off current allows power designs to meet standby and&#xA;offâˆ’power drain specifications.&#xA;The FPF1204 is controlled by a logic input (ON pin) compatible&#xA;with standard CMOS GPIO circuitry found on Field Programmable&#xA;Gate Array (FPGA) embedded processors.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:d282d03f-1a04-4401-b35f-e226a908af5d</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:69149ed8-9dea-4c58-ac36-57a6473a4422</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
