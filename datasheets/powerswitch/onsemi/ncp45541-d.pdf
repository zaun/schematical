         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP45541 - ecoSWITCHâ„¢ Advanced Load Management Controlled Load Switch with Low RON</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCP45541 load switch provides a component and areareducing&#xA;solution for efficient power domain switching with inrush&#xA;current limit via softâˆ’start. In addition to integrated control&#xA;functionality with ultra low onâˆ’resistance, this device offers system&#xA;monitoring via power good signaling. This cost effective solution is&#xA;ideal for power management and hot-swap applications requiring low&#xA;power consumption in a small footprint.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmp:CreateDate>2026-05-28T09:52:14-07:00</xmp:CreateDate>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
