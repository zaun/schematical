         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">FPF1038 - Low On-Resistance, Slew-Rate-Controlled Load Switch</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The FPF1038 advanced load-management switch target applications requiring a highly integrated solution for disconnecting loads powered from DC power rail (&lt;6 V) with stringent shutdown current targets and high load capacitances (up to 200 Î¼F).</rdf:li>
            </rdf:Alt>
         </dc:description>
