<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 9.1-c001 79.675d0f7, 2023/06/11-19:21:16        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP330/NCV330 - Soft-Start Controlled Load Switch</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCP330/NCV330 is a low Ron N-channel MOSFET controlled&#xD;&#xA;by a soft-start sequence of 2 ms for mobile applications.&#xD;&#xA;The very low RDS(on) allows system supplying or battery charging&#xD;&#xA;up to DC 3 A. The device is enable automatically if a Power Supply is&#xD;&#xA;connected on Vin pin (active High) and maintained off if no Vin&#xD;&#xA;(internal pull down).&#xD;&#xA;Due to a current consumption optimization, leakage current is&#xD;&#xA;drastically decreased from the battery connected to the device,&#xD;&#xA;allowing long battery life.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2026-09-11T13:42:57-07:00</xmp:ModifyDate>
         <xmp:CreateDate>2026-09-11T13:42:11-07:00</xmp:CreateDate>
         <xmp:MetadataDate>2026-09-11T13:42:57-07:00</xmp:MetadataDate>
         <pdf:Producer>Acrobat Distiller 24.0 (Windows)</pdf:Producer>
         <xmpMM:DocumentID>uuid:720c7a86-d878-4982-9039-974d0883a308</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:8949a946-958b-423e-a3de-c4395682f835</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                           
