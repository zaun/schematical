ategories":[{"CategoryId":2088,"ParentId":2045,"Name":"FETs, MOSFETs","ProductCount":0,"NewProductCount":0,"ImageUrl":"https://mm.digikey.com/Volume0/opasdata/d220001/derivates/3/010/871/273/MFG_TO-220SIS_tmb.jpg","SeoDescription":"Field-effect transistors (FET) are electronic devices which use an electric field to control the flow of current. Application of a voltage to the gate terminal alters the conductivity between the drain and source terminals. FETs are also known as unipolar transistors since they involve single-carrier-type operation. That is, FETs use electrons or holes as charge carriers in their operation, but not both. Field effect transistors generally display very high input impedance at low frequencies. Metal oxide semiconductor field effect transistors, or MOSFETs, are a type of FET.","ChildCategories":[{"CategoryId":278,"ParentId":2088,"Name":"Single FETs, MOSFETs","ProductCount":0,"NewProductCount":0,"ImageUrl":"https://mm.digikey.com/Volume0/opasdata/d220001/derivates/3/002/322/446/MFG_EPC2035_36_37_38_tmb%2864x64%29.jpg","SeoDescription":"Discrete Field Effect Transistors (FETs) are widely used in power conversion, motor control, solid-state lighting, and other applications where their characteristic ability to be switched on & off at high frequencies while carrying substantial amounts of current is advantageous. They are used almost universally for applications requiring voltage ratings of a few hundred volts or less, above which other device types such as IGBTs become more competitive.","ChildCategories":[]}]}]}]},"ManufacturerLeadWeeks":"10","ManufacturerPublicQuantity":0,"Series":{"Id":818,"Name":"-"},"Classifications":{"ReachStatus":"REACH Unaffected","RohsStatus":"ROHS3 Compliant","MoistureSensitivityLevel":"3  (168 Hours)","ExportControlClassNumber":"EAR99","HtsusCode":"8541.21.0095"},"OtherNames":["2796-2N7002PWTR","2796-2N7002PWTR-ND","4878-2N7002PWDKR","4878-2N7002PWTR","4878-2N7002PWCT"]}],"FilterOptions":{"Manufacturers":[{"Id":4878,