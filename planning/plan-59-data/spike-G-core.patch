+//
+//  SpikeProbe.swift
+//  schematical — plan-59 spike
+//
+//  Drives the running app from the shell, with no screen and no pointer: the
+//  app polls `<container>/spike-cmd.txt`, runs each line and appends the
+//  result to `<container>/spike-out.txt`. Everything it calls is the public
+//  AppKit / SwiftUI surface a user action reaches (menu item actions,
+//  NSDocument, NSDocumentController, the responder chain).
+//
+
+import AppKit
+import SwiftUI
+
+@MainActor
+enum SpikeProbe {
+    private static let home = URL(fileURLWithPath: NSHomeDirectory())
+    private static let commandURL = home.appendingPathComponent("spike-cmd.txt")
+    private static let outputURL = home.appendingPathComponent("spike-out.txt")
+    private static var timer: Timer?
+    private static var busy = false
+    static var weakRefs: [String: () -> AnyObject?] = [:]
+
+    static func install() {
+        timer = Timer.scheduledTimer(withTimeInterval: 0.2, repeats: true) { _ in
+            MainActor.assumeIsolated { poll() }
+        }
+        RunLoop.main.add(timer!, forMode: .common)
+        SpikeLog.log("probe installed pid=\(ProcessInfo.processInfo.processIdentifier)")
+    }
+
+    private static func poll() {
+        guard !busy, let text = try? String(contentsOf: commandURL, encoding: .utf8) else { return }
+        try? FileManager.default.removeItem(at: commandURL)
+        busy = true
+        Task { @MainActor in
+            for line in text.split(separator: "\n").map(String.init) where !line.isEmpty {
+                let result = await run(line)
+                append("> \(line)\n\(result)\n")
+                await endEvent()
+            }
+            append("<done>\n")
+            busy = false
+        }
+    }
+
+    /// A user action is one NSEvent, and AppKit closes the undo manager's
+    /// by-event group when that event has been handled. Commands arrive on a
+    /// timer, so each is followed by one application-defined event to give
+    /// it the same end-of-event processing.
+    private static func endEvent() async {
+        if let event = NSEvent.otherEvent(with: .applicationDefined, location: .zero, modifierFlags: [], timestamp: 0,
+                                          windowNumber: 0, context: nil, subtype: 0, data1: 5959, data2: 0) {
+            NSApp.postEvent(event, atStart: false)
+        }
+        try? await Task.sleep(for: .milliseconds(60))
+    }
+
+    private static func append(_ text: String) {
+        if let handle = try? FileHandle(forWritingTo: outputURL) {
+            handle.seekToEndOfFile()
+            handle.write(Data(text.utf8))
+            try? handle.close()
+        } else {
+            try? Data(text.utf8).write(to: outputURL)
+        }
+    }
+
+    // MARK: Lookup
+
+    static var documents: [NSDocument] { NSDocumentController.shared.documents }
+
+    static func model(of document: NSDocument) -> SchematicDocumentModel? {
+        let windows = document.windowControllers.compactMap(\.window)
+        return SchematicDocumentModel.all.first { model in windows.contains { $0 === model.window } }
+    }
+
+    private static func document(_ index: String?) -> NSDocument? {
+        guard let i = Int(index ?? "0"), documents.indices.contains(i) else { return nil }
+        return documents[i]
+    }
+
+    private static func item(path: String) -> (NSMenu, Int)? {
+        var menu = NSApp.mainMenu
+        let names = path.components(separatedBy: ">")
+        for (depth, name) in names.enumerated() {
+            guard let current = menu else { return nil }
+            current.update()
+            guard let index = current.items.firstIndex(where: { $0.title == name || $0.title.hasPrefix(name) && name.hasSuffix("*") == false && $0.title == name })
+                ?? current.items.firstIndex(where: { name.hasSuffix("*") && $0.title.hasPrefix(String(name.dropLast())) }) else { return nil }
+            if depth == names.count - 1 { return (current, index) }
+            menu = current.items[index].submenu
+        }
+        return nil
+    }
+
+    private static func describe(_ menu: NSMenu, indent: String = "") -> String {
+        menu.update()
+        var lines: [String] = []
+        for item in menu.items {
+            if item.isSeparatorItem { lines.append("\(indent)---"); continue }
+            var key = ""
+            if !item.keyEquivalent.isEmpty {
+                let m = item.keyEquivalentModifierMask
+                key = " [" + (m.contains(.control) ? "⌃" : "") + (m.contains(.option) ? "⌥" : "")
+                    + (m.contains(.shift) ? "⇧" : "") + (m.contains(.command) ? "⌘" : "") + item.keyEquivalent + "]"
+            }
+            let flags = (item.isEnabled ? "" : " (disabled)") + (item.isHidden ? " (hidden)" : "")
+                + (item.isAlternate ? " (alternate)" : "")
+            let action = item.action.map { " -> \(NSStringFromSelector($0))" } ?? ""
+            lines.append("\(indent)\(item.title)\(key)\(flags)\(action)")
+            if let sub = item.submenu { lines.append(describe(sub, indent: indent + "    ")) }
+        }
+        return lines.joined(separator: "\n")
+    }
+
+    private static func describe(_ document: NSDocument, _ index: Int) -> String {
