+        case "windows":
+            return NSApp.windows.map { w in
+                "#\(w.windowNumber) \(type(of: w)) '\(w.title)' visible=\(w.isVisible) key=\(w.isKeyWindow) main=\(w.isMainWindow)"
+                    + " edited=\(w.isDocumentEdited) doc=\(w.windowController?.document != nil) tabs=\(w.tabbedWindows?.count ?? 1)"
+                    + " sheet=\(w.attachedSheet.map { "\(type(of: $0)) '\($0.title)'" } ?? "none") frame=\(Int(w.frame.width))x\(Int(w.frame.height))"
+            }.joined(separator: "\n")
+        case "menu":
