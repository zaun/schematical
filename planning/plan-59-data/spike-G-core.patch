+        case "resave":
+            SchematicDocumentModel.resavesAfterMove = rest == "on"
+            return "resavesAfterMove=\(SchematicDocumentModel.resavesAfterMove)"
+        case "quit":
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) { NSApp.terminate(nil) }
+            return "terminate sent"
+        case "sleep":
+            try? await Task.sleep(for: .milliseconds(Int(rest) ?? 500))
+            return "slept"
+        default:
+            return "unknown command"
+        }
+    }
+
+    private static func responder(_ window: NSWindow, _ document: NSDocument?) -> String {
+        let first = window.firstResponder
+        let editor = first as? NSTextView
+        let manager = first?.undoManager
+        return "firstResponder=\(first.map { "\(type(of: $0))" } ?? "nil") text='\(editor?.string ?? "-")'"
+            + " responderUndoManagerIsDocuments=\(manager != nil && manager === document?.undoManager)"
+            + " canUndo=\(manager?.canUndo ?? false) title='\(manager?.undoMenuItemTitle ?? "-")'"
+    }
+
+    private static func allSubviews(of view: NSView?) -> [NSView] {
+        guard let view else { return [] }
+        return [view] + view.subviews.flatMap { allSubviews(of: $0) }
+    }
+}
