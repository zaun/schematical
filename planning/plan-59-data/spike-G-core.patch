+        text += " autosaveURL=\(document.autosavedContentsFileURL?.lastPathComponent ?? "nil") locked=\(document.isLocked)"
+        text += " type=\(document.fileType ?? "nil") undo=\(document.undoManager.map { "can=\($0.canUndo) '\($0.undoMenuItemTitle)' redo=\($0.canRedo) '\($0.redoMenuItemTitle)'" } ?? "nil")"
