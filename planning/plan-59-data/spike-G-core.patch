+            text += "\n    window '\(window.title)' visible=\(window.isVisible) key=\(window.isKeyWindow) main=\(window.isMainWindow)"
+                + " edited=\(window.isDocumentEdited) represented=\(window.representedURL?.lastPathComponent ?? "nil")"
+                + " tabs=\(window.tabbedWindows?.count ?? 1) tabbingMode=\(window.tabbingMode.rawValue)"
+                + " sheet=\(window.attachedSheet.map { "\(type(of: $0)) '\($0.title)'" } ?? "none") #\(window.windowNumber)"
+        }
+        if let model {
+            text += "\n    model id=\(model.id) url=\(model.fileURL?.path ?? "nil") parts=\(model.document.chips.count)"
+                + " labels=\(model.document.netLabels.count) playing=\(model.document.isPlaying)"
+                + " sameUndoManager=\(model.undoManager === document.undoManager)"
+        } else {
+            text += "\n    model: none found"
+        }
+        return text
+    }
+
+    // MARK: Commands
+
