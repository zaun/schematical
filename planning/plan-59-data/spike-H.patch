--- /dev/null
+++ b/schematical/schematical/Document/SchematicUndoBridge.swift
@@ -0,0 +1,103 @@
+//
+//  SchematicUndoBridge.swift
+//  schematical — plan-59 spike (probe U3)
+//
+//  One NSUndoManager per document. Each UndoStep the document records becomes
+//  one undo registration on the document's manager; its handler applies the
+//  step's diff and registers the opposite direction. The per-page lists in
+//  UndoHistory are not used.
+//
+
+import AppKit
+import Foundation
+
+@MainActor
+final class SchematicUndoBridge {
+    private weak var document: SchematicDocument?
+    private(set) weak var manager: UndoManager?
+    /// The step on top of the manager's undo stack while typing may still
+    /// merge into it (`UndoStep.coalescing`).
+    private var open: UndoStep?
+    /// Counts for the probes.
+    private(set) var registrations = 0
+    private(set) var merges = 0
+
+    init(document: SchematicDocument) {
+        self.document = document
+        document.onStep = { [weak self] step, _ in self?.record(step) }
+        document.onEndCoalescing = { [weak self] in self?.open = nil }
+        document.onHistoryCleared = { [weak self] in
+            guard let self, let manager = self.manager else { return }
+            manager.removeAllActions(withTarget: self)
+            self.open = nil
+        }
+    }
+
+    func connect(_ manager: UndoManager?) {
+        guard manager !== self.manager else { return }
+        self.manager = manager
+        open = nil
+        SpikeLog.log("undo bridge connected manager=\(manager.map { "\(Unmanaged.passUnretained($0).toOpaque())" } ?? "nil") "
+            + "groupsByEvent=\(manager?.groupsByEvent ?? false) levels=\(manager?.levelsOfUndo ?? -1)")
+    }
+
+    /// The next step starts a new registration (a save happened, or the
+    /// field lost focus).
+    func endCoalescing() { open = nil }
+
+    private func record(_ step: UndoStep) {
+        guard let manager, !manager.isUndoing, !manager.isRedoing else { return }
+        if let key = step.coalescing, let top = open, top.coalescing == key {
+            // Typing: fold into the step already registered. The handler
+            // reads `top.changes` when it runs, so no new registration.
+            for (item, change) in step.changes {
+                if let older = top.changes[item] {
+                    top.changes[item] = UndoChange(before: older.before, after: change.after)
+                } else {
+                    top.changes[item] = change
+                }
+            }
+            top.changes = top.changes.filter { $0.value.before != $0.value.after }
+            merges += 1
+            return
+        }
+        open = step.coalescing == nil ? nil : step
+        register(step, backwards: true)
+    }
+
+    private func register(_ step: UndoStep, backwards: Bool) {
+        guard let manager else { return }
+        registrations += 1
+        manager.registerUndo(withTarget: self) { bridge in
+            bridge.open = nil
+            guard let document = bridge.document else { return }
+            if document.applyStep(step, backwards: backwards) {
+                bridge.register(step, backwards: !backwards)
+            } else if document.isPlaying {
+                // Nothing is undone while the simulation runs (probe U5).
+                // The action is already off the stack; put it back where it
+                // was once this undo or redo has finished.
+                SpikeLog.log("undo refused while playing: \(step.name)")
+                bridge.restore(step, backwards: backwards, wasUndo: manager.isUndoing)
+            } else {
+                SpikeLog.log("undo step no longer applies: \(step.name)")
+            }
+        }
+        manager.setActionName(step.name)
+    }
+
+    /// Puts a refused action back: registering during an undo lands on the
+    /// redo stack, so the opposite operation moves it home, with the
+    /// handler told to do nothing on the way.
+    private var returning = false
+    private func restore(_ step: UndoStep, backwards: Bool, wasUndo: Bool) {
+        guard let manager else { return }
+        manager.registerUndo(withTarget: self) { bridge in
+            bridge.register(step, backwards: backwards)
+        }
+        manager.setActionName(step.name)
+        DispatchQueue.main.async {
+            if wasUndo { manager.redo() } else { manager.undo() }
+        }
+    }
+}
