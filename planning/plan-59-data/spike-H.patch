+//
+//  SpikeProbe.swift
+//  schematical — plan-59 spike
+//
+//  Drives the running app from the shell, with no screen and no pointer: the
+//  app polls `<container>/spike-cmd.txt`, runs each line and appends the
+//  result to `<container>/spike-out.txt`. Everything it calls is the public
+//  AppKit / SwiftUI surface a user action reaches (menu item actions,
+//  NSDocument, NSDocumentController, the responder chain).
+//
+
+import AppKit
+import SwiftUI
+
+@MainActor
+enum SpikeProbe {
+    private static let home = URL(fileURLWithPath: NSHomeDirectory())
+    private static let commandURL = home.appendingPathComponent("spike-cmd.txt")
+    private static let outputURL = home.appendingPathComponent("spike-out.txt")
+    private static var timer: Timer?
+    private static var busy = false
+    static var weakRefs: [String: () -> AnyObject?] = [:]
+
+    static func install() {
+        timer = Timer.scheduledTimer(withTimeInterval: 0.2, repeats: true) { _ in
+            MainActor.assumeIsolated { poll() }
+        }
+        RunLoop.main.add(timer!, forMode: .common)
+        SpikeLog.log("probe installed pid=\(ProcessInfo.processInfo.processIdentifier)")
+    }
+
+    private static func poll() {
+        guard !busy, let text = try? String(contentsOf: commandURL, encoding: .utf8) else { return }
+        try? FileManager.default.removeItem(at: commandURL)
+        busy = true
+        Task { @MainActor in
+            for line in text.split(separator: "\n").map(String.init) where !line.isEmpty {
+                let result = await run(line)
+                append("> \(line)\n\(result)\n")
+                await endEvent()
+            }
+            append("<done>\n")
+            busy = false
+        }
+    }
+
+    /// A user action is one NSEvent, and AppKit closes the undo manager's
+    /// by-event group when that event has been handled. Commands arrive on a
+    /// timer, so each is followed by one application-defined event to give
+    /// it the same end-of-event processing.
+    private static func endEvent() async {
+        if let event = NSEvent.otherEvent(with: .applicationDefined, location: .zero, modifierFlags: [], timestamp: 0,
+                                          windowNumber: 0, context: nil, subtype: 0, data1: 5959, data2: 0) {
+            NSApp.postEvent(event, atStart: false)
+        }
+        try? await Task.sleep(for: .milliseconds(60))
+    }
+
+    private static func append(_ text: String) {
+        if let handle = try? FileHandle(forWritingTo: outputURL) {
+            handle.seekToEndOfFile()
+            handle.write(Data(text.utf8))
+            try? handle.close()
+        } else {
+            try? Data(text.utf8).write(to: outputURL)
+        }
+    }
+
+    // MARK: Lookup
+
+    static var documents: [NSDocument] { NSDocumentController.shared.documents }
+
+    static func model(of document: NSDocument) -> SchematicDocumentModel? {
+        (document as? SchematicNSDocument)?.model
+    }
+
+    private static func document(_ index: String?) -> NSDocument? {
+        guard let i = Int(index ?? "0"), documents.indices.contains(i) else { return nil }
+        return documents[i]
+    }
+
+    private static func item(path: String) -> (NSMenu, Int)? {
+        var menu = NSApp.mainMenu
+        let names = path.components(separatedBy: ">")
+        for (depth, name) in names.enumerated() {
+            guard let current = menu else { return nil }
+            current.update()
+            guard let index = current.items.firstIndex(where: { $0.title == name || $0.title.hasPrefix(name) && name.hasSuffix("*") == false && $0.title == name })
+                ?? current.items.firstIndex(where: { name.hasSuffix("*") && $0.title.hasPrefix(String(name.dropLast())) }) else { return nil }
+            if depth == names.count - 1 { return (current, index) }
+            menu = current.items[index].submenu
+        }
+        return nil
+    }
+
+    private static func describe(_ menu: NSMenu, indent: String = "") -> String {
+        menu.update()
+        var lines: [String] = []
+        for item in menu.items {
+            if item.isSeparatorItem { lines.append("\(indent)---"); continue }
+            var key = ""
+            if !item.keyEquivalent.isEmpty {
+                let m = item.keyEquivalentModifierMask
+                key = " [" + (m.contains(.control) ? "⌃" : "") + (m.contains(.option) ? "⌥" : "")
+                    + (m.contains(.shift) ? "⇧" : "") + (m.contains(.command) ? "⌘" : "") + item.keyEquivalent + "]"
+            }
+            let flags = (item.isEnabled ? "" : " (disabled)") + (item.isHidden ? " (hidden)" : "")
+                + (item.isAlternate ? " (alternate)" : "")
+            let action = item.action.map { " -> \(NSStringFromSelector($0))" } ?? ""
+            lines.append("\(indent)\(item.title)\(key)\(flags)\(action)")
+            if let sub = item.submenu { lines.append(describe(sub, indent: indent + "    ")) }
+        }
+        return lines.joined(separator: "\n")
+    }
+
+    private static func describe(_ document: NSDocument, _ index: Int) -> String {
+        let model = model(of: document)
+        let windows = document.windowControllers.compactMap(\.window)
+        var text = "[\(index)] \(type(of: document)) name=\(document.displayName ?? "nil") url=\(document.fileURL?.path ?? "nil")"
+        text += " edited=\(document.isDocumentEdited) unautosaved=\(document.hasUnautosavedChanges)"
+        text += " autosaveURL=\(document.autosavedContentsFileURL?.lastPathComponent ?? "nil") locked=\(document.isLocked)"
+        text += " type=\(document.fileType ?? "nil") undo=\(document.undoManager.map { "can=\($0.canUndo) '\($0.undoMenuItemTitle)' redo=\($0.canRedo) '\($0.redoMenuItemTitle)'" } ?? "nil")"
+        for window in windows {
+            text += "\n    window '\(window.title)' visible=\(window.isVisible) key=\(window.isKeyWindow) main=\(window.isMainWindow)"
+                + " edited=\(window.isDocumentEdited) represented=\(window.representedURL?.lastPathComponent ?? "nil")"
+                + " tabs=\(window.tabbedWindows?.count ?? 1) tabbingMode=\(window.tabbingMode.rawValue)"
+                + " sheet=\(window.attachedSheet.map { "\(type(of: $0)) '\($0.title)'" } ?? "none") #\(window.windowNumber)"
+        }
+        if let model {
+            text += "\n    model id=\(model.id) url=\(model.fileURL?.path ?? "nil") parts=\(model.document.chips.count)"
+                + " labels=\(model.document.netLabels.count) playing=\(model.document.isPlaying)"
+                + " sameUndoManager=\(model.undoManager === document.undoManager)"
+        } else {
+            text += "\n    model: none found"
+        }
+        return text
+    }
+
+    // MARK: Commands
+
+    private static func run(_ line: String) async -> String {
+        let parts = line.split(separator: " ", maxSplits: 1).map(String.init)
+        let command = parts[0]
+        let rest = parts.count > 1 ? parts[1] : ""
+        let args = rest.split(separator: " ").map(String.init)
+        switch command {
+        case "docs":
+            let list = documents.enumerated().map { describe($1, $0) }.joined(separator: "\n")
+            return "active=\(NSApp.isActive) documents=\(documents.count) models=\(SchematicDocumentModel.all.count)\n\(list)"
+        case "windows":
+            return NSApp.windows.map { w in
+                "#\(w.windowNumber) \(type(of: w)) '\(w.title)' visible=\(w.isVisible) key=\(w.isKeyWindow) main=\(w.isMainWindow)"
+                    + " edited=\(w.isDocumentEdited) doc=\(w.windowController?.document != nil) tabs=\(w.tabbedWindows?.count ?? 1)"
+                    + " sheet=\(w.attachedSheet.map { "\(type(of: $0)) '\($0.title)'" } ?? "none") frame=\(Int(w.frame.width))x\(Int(w.frame.height))"
+            }.joined(separator: "\n")
+        case "menu":
+            guard let menu = NSApp.mainMenu else { return "no main menu" }
+            if rest.isEmpty { return menu.items.map(\.title).joined(separator: " | ") }
+            guard let top = menu.items.first(where: { $0.title == rest })?.submenu else { return "no menu \(rest)" }
+            return describe(top)
+        case "click":
+            guard let (menu, index) = item(path: rest) else { return "no item \(rest)" }
+            let item = menu.items[index]
+            guard item.isEnabled else { return "item '\(item.title)' is disabled" }
+            menu.performActionForItem(at: index)
+            return "clicked '\(item.title)' -> \(item.action.map { NSStringFromSelector($0) } ?? "nil")"
+        case "activate":
+            NSApp.activate(ignoringOtherApps: true)
+            if let i = Int(rest), documents.indices.contains(i) {
+                documents[i].windowControllers.first?.window?.makeKeyAndOrderFront(nil)
+            }
+            try? await Task.sleep(for: .milliseconds(300))
+            return "active=\(NSApp.isActive) key=\(NSApp.keyWindow?.title ?? "nil") main=\(NSApp.mainWindow?.title ?? "nil")"
+        case "new":
+            NSDocumentController.shared.newDocument(nil)
+            return "newDocument sent"
+        case "open":
+            let url = URL(fileURLWithPath: rest)
+            do {
+                let (document, already) = try await NSDocumentController.shared.openDocument(withContentsOf: url, display: true)
+                return "opened \(document.displayName ?? "?") alreadyOpen=\(already)"
+            } catch { return "open failed: \(error.localizedDescription)" }
+        case "saveto", "saveas", "save", "autosave":
+            guard let document = document(args.first) else { return "no document" }
+            let url = command == "save" || command == "autosave" ? document.fileURL : args.count > 1 ? URL(fileURLWithPath: args[1]) : nil
+            if command == "autosave" {
+                return await withCheckedContinuation { c in
+                    document.autosave(withImplicitCancellability: false) { error in
+                        c.resume(returning: "autosave: \(error?.localizedDescription ?? "ok")")
+                    }
+                }
+            }
+            guard let url, let type = document.fileType else { return "no url or type" }
+            let operation: NSDocument.SaveOperationType = command == "save" ? .saveOperation
+                : command == "saveto" ? .saveToOperation : .saveAsOperation
+            return await withCheckedContinuation { c in
+                document.save(to: url, ofType: type, for: operation) { error in
+                    c.resume(returning: "\(command): \(error?.localizedDescription ?? "ok") -> \(url.path)")
+                }
+            }
+        case "duplicate":
+            guard let document = document(args.first) else { return "no document" }
+            do {
+                let copy = try document.duplicate()
+                return "duplicate: \(copy.displayName ?? "?") url=\(copy.fileURL?.path ?? "nil") autosave=\(copy.autosavedContentsFileURL?.path ?? "nil")"
+            } catch { return "duplicate failed: \(error.localizedDescription)" }
+        case "close":
+            guard let document = document(args.first) else { return "no document" }
+            document.close()
+            return "closed"
+        case "performclose":
+            guard let window = document(args.first)?.windowControllers.first?.window else { return "no window" }
+            window.performClose(nil)
+            return "performClose sent"
+        case "revert":
+            guard let document = document(args.first), let url = document.fileURL, let type = document.fileType else { return "no document" }
+            do { try document.revert(toContentsOf: url, ofType: type); return "reverted" }
+            catch { return "revert failed: \(error.localizedDescription)" }
+        case "mem":
+            guard let document = document(args.first), let model = model(of: document) else { return "no model" }
+            return model.document.chips.filter { $0.memoryFile != nil }.map { chip in
+                let file = chip.memoryFile!
+                var text = "\(chip.reference) \(chip.partNumber) url=\(file.url.path) bookmark=\(file.bookmark == nil ? "none" : "\(file.bookmark!.count) bytes")"
+                do {
+                    let data = try MemoryFileAccess.read(file)
+                    text += " read=\(data.count) bytes first=\(data.prefix(4).map { String(format: "%02X", $0) }.joined())"
+                } catch { text += " read FAILED: \(error.localizedDescription)" }
+                return text
+            }.joined(separator: "\n")
+        case "bookmark":
+            // Gives the first EEPROM's load file an app-scoped bookmark, as choosing it in the open panel does.
+            guard let document = document(args.first), let model = model(of: document),
+                  let chip = model.document.chips.first(where: { $0.memoryFile != nil }) else { return "no chip" }
+            let url = chip.memoryFile!.url
+            let bookmark = MemoryFileAccess.bookmark(for: url)
+            model.document.setMemoryFile(chip.id, MemoryFile(url: url, bookmark: bookmark))
+            return "bookmark=\(bookmark.map { "\($0.count) bytes" } ?? "none")"
+        case "edit":
+            guard let document = document(args.first), let model = model(of: document) else { return "no model" }
