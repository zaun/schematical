+                _ = SchematicFile(document: model.document, fileURL: model.fileURL)
+                times.append((CACurrentMediaTime() - start) * 1000)
+            }
+            times.sort()
+            return String(format: "snapshot ms: median %.3f min %.3f max %.3f (n=20, parts %d)",
+                          (times[9] + times[10]) / 2, times[0], times[19], model.document.chips.count)
+        case "shot":
