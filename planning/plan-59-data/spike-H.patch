+            guard args.count > 1, let window = document(args.first)?.windowControllers.first?.window, let index = Int(args[1]) else { return "usage: press <doc> <control>" }
+            let controls = toolbarControls(window)
+            guard controls.indices.contains(index), let button = controls[index] as? NSButton else { return "no button \(index)" }
+            button.performClick(nil)
+            return "pressed '\(button.title)' tip='\(button.toolTip ?? "")'"
+        case "lockdoc":
+            guard let document = document(args.first) else { return "no document" }
+            return await withCheckedContinuation { c in
+                document.lock { error in c.resume(returning: "lock: \(error?.localizedDescription ?? "ok") isLocked=\(document.isLocked)") }
+            }
+        case "unlockdoc":
+            guard let document = document(args.first) else { return "no document" }
+            return await withCheckedContinuation { c in
+                document.unlock { error in c.resume(returning: "unlock: \(error?.localizedDescription ?? "ok") isLocked=\(document.isLocked)") }
+            }
+        case "versions":
+            guard let url = document(args.first)?.fileURL else { return "no file" }
+            let others = NSFileVersion.otherVersionsOfItem(at: url) ?? []
+            return "current=\(NSFileVersion.currentVersionOfItem(at: url) != nil) otherVersions=\(others.count) "
+                + others.prefix(4).map { "\($0.modificationDate.map { ISO8601DateFormatter().string(from: $0) } ?? "?")" }.joined(separator: " ")
+        case "terminate":
+            NSApp.terminate(nil)
+            return "terminate returned (cancelled or waiting on a sheet)"
+        case "tabs":
+            return NSApp.windows.filter { $0.windowController?.document != nil }.map { w in
+                "'\(w.title)' tabGroupWindows=\(w.tabGroup?.windows.count ?? 0) tabbingMode=\(w.tabbingMode.rawValue) userPref=\(NSWindow.userTabbingPreference.rawValue) id=\(w.tabbingIdentifier)"
+            }.joined(separator: "\n")
+        case "closewindow":
+            // Closes a window by title, as its close button does.
+            guard let window = NSApp.windows.first(where: { $0.title == rest && $0.isVisible }) else { return "no visible window titled \(rest)" }
+            window.performClose(nil)
+            try? await Task.sleep(for: .milliseconds(300))
+            return "performClose sent; still visible=\(window.isVisible)"
+        case "only":
+            // Closes every document but the one whose name starts with the argument, without asking.
+            for document in documents where !(document.displayName ?? "").hasPrefix(rest) { document.close() }
+            try? await Task.sleep(for: .milliseconds(400))
+            return "documents=\(documents.map { $0.displayName ?? "?" })"
+        case "default":
+            // Sets one of the app's own defaults (its container's domain only).
+            guard args.count > 1 else { return "usage: default <key> <true|false|string>" }
+            switch args[1] {
+            case "true": UserDefaults.standard.set(true, forKey: args[0])
+            case "false": UserDefaults.standard.set(false, forKey: args[0])
+            case "remove": UserDefaults.standard.removeObject(forKey: args[0])
+            default: UserDefaults.standard.set(args[1], forKey: args[0])
+            }
+            UserDefaults.standard.synchronize()
+            return "\(args[0]) = \(UserDefaults.standard.object(forKey: args[0]).map { "\($0)" } ?? "unset")"
+        case "titlebar":
+            guard let window = document(args.first)?.windowControllers.first?.window else { return "no window" }
+            let icon = window.standardWindowButton(.documentIconButton)
+            let close = window.standardWindowButton(.closeButton)
+            return "title='\(window.title)' subtitle='\(window.subtitle)' titleVisibility=\(window.titleVisibility == .visible ? "visible" : "hidden")"
+                + " toolbarStyle=\(window.toolbarStyle.rawValue) representedURL=\(window.representedURL?.lastPathComponent ?? "nil")"
+                + " documentIconButton=\(icon == nil ? "none" : (icon!.isHidden || icon!.superview == nil ? "hidden" : "shown"))"
+                + " isDocumentEdited=\(window.isDocumentEdited) closeButton=\(close == nil ? "none" : "present")"
+                + " tabs=\(window.tabbedWindows?.count ?? 1) tab.title='\(window.tab.title)'"
+        case "tool":
+            // Calls an agent-control tool as the MCP server's dispatcher does (AutomationTools.call).
+            guard let name = args.first else { return "usage: tool <name> [json arguments]" }
+            let json = rest.dropFirst(name.count).trimmingCharacters(in: .whitespaces)
+            let arguments = (try? JSONSerialization.jsonObject(with: Data((json.isEmpty ? "{}" : json).utf8))) as? [String: Any] ?? [:]
+            let result = await AutomationTools.call(name, arguments)
+            let texts = (result["content"] as? [[String: Any]] ?? []).compactMap { $0["text"] as? String }
+            return (result["isError"] as? Bool == true ? "ERROR: " : "") + texts.joined(separator: "\n")
+        case "choosefolder":
+            DispatchQueue.main.async { AutomationFolder.shared.choose() }
+            return "the folder panel is opening"
+        case "folder":
+            return "shared folder: \(AutomationFolder.shared.url?.path ?? "none")"
+        case "resave":
+            SchematicDocumentModel.resavesAfterMove = rest == "on"
+            return "resavesAfterMove=\(SchematicDocumentModel.resavesAfterMove)"
+        case "quit":
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) { NSApp.terminate(nil) }
+            return "terminate sent"
+        case "sleep":
+            try? await Task.sleep(for: .milliseconds(Int(rest) ?? 500))
+            return "slept"
+        default:
+            return "unknown command"
+        }
+    }
+
+    private static func toolbarControls(_ window: NSWindow) -> [NSControl] {
+        let views = (window.toolbar?.items ?? []).compactMap(\.view)
+        return views.flatMap { allSubviews(of: $0) }.compactMap { $0 as? NSControl }
+            .filter { $0 is NSSegmentedControl || $0 is NSButton }
+    }
+
+    private static func responder(_ window: NSWindow, _ document: NSDocument?) -> String {
+        let first = window.firstResponder
+        let editor = first as? NSTextView
+        let manager = first?.undoManager
+        return "firstResponder=\(first.map { "\(type(of: $0))" } ?? "nil") text='\(editor?.string ?? "-")'"
+            + " responderUndoManagerIsDocuments=\(manager != nil && manager === document?.undoManager)"
+            + " canUndo=\(manager?.canUndo ?? false) title='\(manager?.undoMenuItemTitle ?? "-")'"
+    }
+
+    private static func allSubviews(of view: NSView?) -> [NSView] {
+        guard let view else { return [] }
+        return [view] + view.subviews.flatMap { allSubviews(of: $0) }
+    }
+}
