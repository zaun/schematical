+//  The DocumentGroup document: a ReferenceFileDocument that owns what
+//  ContentView.init used to build (SchematicDocument, SimulationController)
+//  and reads and writes it through the unchanged SchematicFile.
+//
+
+import AppKit
+import Combine
+import Foundation
+import QuartzCore
+import SwiftUI
+import UniformTypeIdentifiers
+
+/// One line per event, in the app's container (`~/Library/Containers/<id>/Data/spike59.log`),
+/// so a probe's evidence can be read from the shell.
+nonisolated enum SpikeLog {
+    static let url = URL(fileURLWithPath: NSHomeDirectory()).appendingPathComponent("spike59.log")
+    private static let lock = NSLock()
+
+    static func log(_ text: String) {
+        lock.lock()
+        defer { lock.unlock() }
+        let line = String(format: "%.3f ", Date().timeIntervalSince1970) + text + "\n"
+        if let handle = try? FileHandle(forWritingTo: url) {
+            handle.seekToEndOfFile()
+            handle.write(Data(line.utf8))
+            try? handle.close()
+        } else {
+            try? Data(line.utf8).write(to: url)
+        }
+    }
+}
+
+/// Nonisolated: the protocol is `Sendable` with nonisolated requirements, and
+/// SwiftUI calls `init(configuration:)` and `fileWrapper(snapshot:configuration:)`
+/// off the main thread. Everything that touches the document is `@MainActor`.
+nonisolated final class SchematicDocumentModel: ReferenceFileDocument, @unchecked Sendable {
+    typealias Snapshot = SchematicFile
+
+    static var readableContentTypes: [UTType] { [SchematicFile.contentType] }
+
+    /// Identifies this document to its child windows (plan-59-B).
+    let id = UUID()
+
+    /// The decoded file, read off the main thread, waiting for the main actor
+    /// (and the file's URL) to be applied.
+    private let pendingLock = NSLock()
+    private var pending: SchematicFile?
+
+    @MainActor private var built: (document: SchematicDocument, simulation: SimulationController)?
+    /// Exports and print for this document (what is left of the old file controller).
+    @MainActor private var controller: SchematicFileController?
+    @MainActor var file: SchematicFileController {
+        _ = build()
+        return controller!
+    }
+
+    /// A child window's document and simulation, by the document's id.
+    @MainActor
+    static func session(_ id: UUID) -> (document: SchematicDocument, simulation: SimulationController)? {
+        let found = model(id: id)
+        let line = "child window resolved document \(id.uuidString.prefix(8)) -> "
+            + (found.map { "\($0.fileURL?.lastPathComponent ?? "Untitled") parts=\($0.document.chips.count)" } ?? "none")
+        if !loggedSessions.contains(line) {
+            loggedSessions.insert(line)
+            SpikeLog.log(line)
+        }
+        return found.map { ($0.document, $0.simulation) }
+    }
+    @MainActor private static var loggedSessions = Set<String>()
+
+    /// Probe A5: opens a child window of this document through the scene's
+    /// `openWindow`, and the calls that dismiss the ones opened this way.
+    @MainActor var openChild: ((String, UUID?) -> Void)?
+    /// The page the editor shows; the NSDocument stores it in its restorable state.
+    @MainActor var page = EditorPage.schematic
+    @MainActor var childDismissers: [() -> Void] = []
+    /// The file's URL, handed over by the editor view: SwiftUI gives it to
+    /// neither the reader nor the writer.
+    @MainActor private(set) var fileURL: URL?
+    @MainActor private(set) var loadError: String?
+    /// The undo manager SwiftUI gives the editor view (plan-59-A phase 4),
+    /// and the bridge that turns each document step into a registration on it.
+    @MainActor weak var undoManager: UndoManager?
+    @MainActor private(set) var undoBridge: SchematicUndoBridge?
+    /// Probe F2: after the URL changes, mark the document edited so the next
+    /// autosave rewrites load-file paths relative to the new folder.
+    @MainActor static var resavesAfterMove = false
+
+    @MainActor
+    func connectUndo(_ manager: UndoManager?) {
+        undoManager = manager
+        _ = document
+        undoBridge?.connect(manager)
+    }
+
+    /// The AppKit document SwiftUI made for this model, found through the
+    /// window (public API: NSWindowController.document).
+    @MainActor var platformDocument: NSDocument? {
+        NSDocumentController.shared.documents.first { ($0 as? SchematicNSDocument)?.model === self }
+    }
+
+    /// The window showing this document, set by the editor view.
+    @MainActor weak var window: NSWindow?
+
+    /// Every live model, held weakly: a child window finds its document here
+    /// by id without keeping it alive (plan-59-B § 4).
+    private static let registryLock = NSLock()
+    private static let registry = NSHashTable<SchematicDocumentModel>.weakObjects()
+
+    static var all: [SchematicDocumentModel] {
+        registryLock.lock()
+        defer { registryLock.unlock() }
+        return registry.allObjects
+    }
+
+    static func model(id: UUID) -> SchematicDocumentModel? {
+        all.first { $0.id == id }
+    }
+
+    private func register() {
+        Self.registryLock.lock()
+        Self.registry.add(self)
+        Self.registryLock.unlock()
+    }
+
+    deinit {
+        SpikeLog.log("model.deinit id=\(id)")
+    }
+
+    /// A new, untitled document.
+    init() {
+        register()
+        SpikeLog.log("model.init() main=\(Thread.isMainThread) id=\(id)")
+    }
+
+    init(configuration: ReadConfiguration) throws {
+        guard let data = configuration.file.regularFileContents else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        pending = try SchematicFile.decode(data)
+        register()
+        SpikeLog.log("model.init(configuration:) main=\(Thread.isMainThread) bytes=\(data.count) "
+            + "filename=\(configuration.file.filename ?? "nil") id=\(id)")
+    }
+
+    // MARK: The document
+
+    @MainActor var document: SchematicDocument { build().document }
+    @MainActor var simulation: SimulationController { build().simulation }
+
+    @MainActor
+    private func build() -> (document: SchematicDocument, simulation: SimulationController) {
+        if let built { return built }
+        let catalog = PartCatalogStore.shared
+        let document = SchematicDocument(library: catalog.library)
+        // A new schematic starts with the standard net classes (an opened
+        // file replaces them with its own), as ContentView.init did.
+        document.addStandardNetClasses()
+        let simulation = SimulationController(library: catalog.library)
+        let pair = (document, simulation)
+        built = pair
+        undoBridge = SchematicUndoBridge(document: document)
+        controller = SchematicFileController(document: document, catalog: catalog,
+                                             willReplaceDocument: { simulation.stop() })
+        return pair
+    }
+
+    /// The editor view calls this with `configuration.fileURL` when it is made
+    /// and when the URL changes. The first call applies a read file, so its
+    /// relative load-file paths resolve against the real URL.
+    @MainActor
+    func attach(fileURL url: URL?) {
+        let changed = url != fileURL
+        fileURL = url
+        file.fileURL = url
+        pendingLock.lock()
+        let file = pending
+        pending = nil
+        pendingLock.unlock()
+        if let file {
+            do {
+                try load(file, fileURL: url)
+                SpikeLog.log("model.attach applied file url=\(url?.path ?? "nil") parts=\(document.chips.count) "
+                    + "catalog=\(PartCatalogStore.shared.loadState)")
+            } catch {
+                loadError = error.localizedDescription
+                SpikeLog.log("model.attach apply FAILED \(error)")
+            }
+        } else if changed {
+            SpikeLog.log("model.attach url changed to \(url?.path ?? "nil")")
+            if Self.resavesAfterMove, document.chips.contains(where: { $0.memoryFile != nil }) {
+                platformDocument?.updateChangeCount(.changeDone)
+                SpikeLog.log("model.attach marked edited so load-file paths are rewritten")
+            }
+        }
+    }
+
+    /// Decodes and applies file bytes; callable from the harness
+    /// (`FileDocumentReadConfiguration` has no public initializer).
+    @MainActor
+    func load(_ data: Data, fileURL url: URL?) throws {
+        fileURL = url
+        try load(SchematicFile.decode(data), fileURL: url)
+    }
+
+    @MainActor
+    private func load(_ file: SchematicFile, fileURL url: URL?) throws {
+        simulation.stop()
+        let embedded = try file.apply(to: document, catalog: PartCatalogStore.shared, fileURL: url)
+        // Custom parts that came with the file and are not in the User Library:
+        // offer to add them, as the old controller's load did (plan-53-C).
+        let offered = UserLibraryPrompts.offerable(embedded, catalog: PartCatalogStore.shared)
+        if !offered.isEmpty {
+            Task { await self.file.offerToAdd(offered) }
+        }
+    }
+
+    // MARK: Writing
+
+    /// The snapshot step, on the main actor; times itself for probe F4.
+    @MainActor
+    func makeSnapshot() -> SchematicFile {
+        let start = CACurrentMediaTime()
+        undoBridge?.endCoalescing()
+        let file = SchematicFile(document: document, fileURL: fileURL)
+        SpikeLog.log(String(format: "model.snapshot ms=%.3f url=%@ memoryPaths=%@",
+                            (CACurrentMediaTime() - start) * 1000, fileURL?.path ?? "nil",
+                            file.parts.compactMap { $0.memoryFile?.path }.description))
+        return file
+    }
+
+    func snapshot(contentType: UTType) throws -> SchematicFile {
+        let onMain = Thread.isMainThread
+        SpikeLog.log("model.snapshot(contentType:) main=\(onMain)")
+        if onMain {
+            return MainActor.assumeIsolated { makeSnapshot() }
+        }
+        // SwiftUI calls this on a background queue while the main thread waits
+        // in -[NSDocument _waitForUserInteractionUnblocking]; a hop to the
+        // main queue deadlocks (evidence/F4-G-snapshot-thread.txt). The
+        // document is read here, in place, with the main thread parked.
+        return Self.withMainActorParked { makeSnapshot() }
+    }
+
+    /// Runs main-actor code on the current thread. Only correct while the
+    /// main thread is blocked waiting for this thread, as it is during
+    /// `snapshot(contentType:)`.
+    private static func withMainActorParked<T>(_ body: @MainActor () -> T) -> T {
+        withoutActuallyEscaping(body) { isolated in
+            unsafeBitCast(isolated, to: (() -> T).self)()
+        }
+    }
+
+    func fileWrapper(snapshot: SchematicFile, configuration: WriteConfiguration) throws -> FileWrapper {
+        SpikeLog.log("model.fileWrapper main=\(Thread.isMainThread) "
+            + "existing=\(configuration.existingFile?.filename ?? "nil")")
+        return FileWrapper(regularFileWithContents: try snapshot.encoded())
+    }
+
+    /// The bytes a save writes, callable from the harness.
+    @MainActor
+    func encodedSnapshot() throws -> Data {
+        try makeSnapshot().encoded()
+    }
+}
+
+/// What the hosted editor still publishes: the focused document, for Commands.
+/// The URL, the undo manager and the child windows come from the NSDocument.
+struct DocumentWiring: ViewModifier {
+    let model: SchematicDocumentModel
+    let fileURL: URL?
+
+    func body(content: Content) -> some View {
+        content
+            .focusedSceneValue(\.schematicModel, model)
+            .onDisappear {
+                SpikeLog.log("editor disappeared: \(model.id.uuidString.prefix(8))")
+            }
+    }
+}
