+                return "unknown edit \(kind)"
+            }
+        case "state":
+            guard let document = document(args.first), let model = model(of: document) else { return "no model" }
+            let doc = model.document
+            let boards = doc.chips.compactMap { chip in chip.board.map { "\(chip.reference)@\(Int($0.centre.x)),\(Int($0.centre.y))" } }.prefix(2)
+            let saved: String
+            if let url = document.fileURL, let data = try? Data(contentsOf: url), let file = try? SchematicFile.decode(data) {
+                saved = "\(file == SchematicFile(document: doc, fileURL: url))"
+            } else { saved = "no file" }
+            return "parts=\(doc.chips.count) labels=\(doc.netLabels.count) lastLabel=\(doc.netLabels.last?.name ?? "-") boards=\(boards.joined(separator: " "))"
+                + " edited=\(document.isDocumentEdited) equalsSavedFile=\(saved)"
+                + " undo='\(document.undoManager?.undoMenuItemTitle ?? "nil")' redo='\(document.undoManager?.redoMenuItemTitle ?? "nil")'"
+                + " registrations=\(model.undoBridge?.registrations ?? -1) merges=\(model.undoBridge?.merges ?? -1)"
+                + " groupingLevel=\(document.undoManager?.groupingLevel ?? -1)"
+        case "undo", "redo":
+            let sent = NSApp.sendAction(Selector((command) + ":"), to: nil, from: nil)
+            return "sendAction(\(command):) handled=\(sent)"
+        case "docundo", "docredo":
+            guard let document = document(args.first), let manager = document.undoManager else { return "no undo manager" }
+            if command == "docundo" { guard manager.canUndo else { return "cannot undo" }; manager.undo() }
+            else { guard manager.canRedo else { return "cannot redo" }; manager.redo() }
+            return "\(command) done"
+        case "play", "stop":
