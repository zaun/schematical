+/* The index of the backplane line named `name` in c->lines, or -1. */
+static int lcd_line_of(const Ld *ld, const DispCfg *c, const char *name) {
+    size_t i;
+
+    for (i = 0; i < c->line_count; i++) {
+        if (strcmp(ld->names[c->lines[i]], name) == 0) {
+            return (int)i;
+        }
+    }
+    return -1;
