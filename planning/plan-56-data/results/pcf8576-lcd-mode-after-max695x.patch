+static void field_set(CvState *s, const CvField *f, uint32_t value) {
+    uint32_t m = (f->hi - f->lo + 1 >= 32 ? 0xFFFFFFFFu : ((1u << (f->hi - f->lo + 1)) - 1u)) << f->lo;
+
+    s->regs[f->reg] = (s->regs[f->reg] & ~m) | ((value << f->lo) & m);
+}
