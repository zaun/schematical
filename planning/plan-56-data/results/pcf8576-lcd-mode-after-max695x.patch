+/* A mode name -> its backplane count (1-4), or 0. */
+static unsigned lcd_mode_slots(const char *name) {
+    static const char *const MODES[] = {"static", "1:2", "1:3", "1:4", NULL};
+    unsigned i;
+
+    for (i = 0; MODES[i] != NULL; i++) {
+        if (strcmp(MODES[i], name) == 0) {
+            return i + 1;
+        }
+    }
+    return 0;
+}
