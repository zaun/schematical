  "protocol": {
   "frame": "fixed",
   "out": "[STATUS] 0{8} R{16} 0{8} R{16} 0{8} 0{24}",
   "idle": "0",
   "commands": [
    {
     "name": "NULL",
     "in": "0{16} x{8}",
     "action": "nop",
     "note": "response in the next frame: the STATUS register (the default out)"
    },
    {
     "name": "RESET",
     "in": "0000000000010001 x{8}",
     "action": "reset",
     "commit": "end",
     "next": "1111111101010010 0{8} R{16} 0{8} R{16} 0{8} 0{24}",
     "note": "latched at the end of the full frame"
    },
    {
     "name": "STANDBY",
     "in": "0000000000100010 x{8}",
     "action": "powerdown",
     "commit": "end",
     "next": "0000000000100010 0{8} R{16} 0{8} R{16} 0{8} 0{24}"
    },
    {
     "name": "WAKEUP",
     "in": "0000000000110011 x{8}",
     "action": "wakeup",
     "commit": "end",
     "next": "0000000000110011 0{8} R{16} 0{8} R{16} 0{8} 0{24}"
    },
    {
     "name": "LOCK",
     "in": "0000010101010101 x{8}",
     "action": "nop",
     "set": {
      "STATUS.LOCK": 1
     },
     "commit": "end",
     "next": "0000010101010101 0{8} R{16} 0{8} R{16} 0{8} 0{24}"
    },
    {
     "name": "UNLOCK",
     "in": "0000011001010101 x{8}",
     "action": "nop",
     "set": {
      "STATUS.LOCK": 0
     },
     "commit": "end",
     "next": "0000011001010101 0{8} R{16} 0{8} R{16} 0{8} 0{24}",
     "note": "command word 0655h per the command table (the section heading prints 0666h)"
    },
    {
     "name": "RREG",
     "in": "101aaaaaa0000000 x{8}",
     "action": "read",
     "address": "a",
     "commit": "end",
     "next": "@ 0{8} R{16} 0{8} R{16} 0{8} 0{24}",
     "note": "single register (nnn nnnn = 0): its contents are the response word of the next frame"
    },
    {
     "name": "RREG multiple",
     "in": "101aaaaaannnnnnn x{8}",
     "action": "read",
     "address": "a",
     "commit": "end",
     "next": "111aaaaaannnnnnn 0{8} @ 0{8}",
     "note": "n > 0: the next frame is the 111a... acknowledgment followed by the registers; only the first register is modeled"
    },
    {
     "name": "WREG",
     "in": "011aaaaaa0000000 x{8} dddddddddddddddd x{8}",
     "action": "write",
     "address": "a",
     "data": "d",
     "next": "010aaaaaa0000000 0{8} R{16} 0{8} R{16} 0{8} 0{24}",
     "note": "single register, its 16 bits MSB-aligned in a 24-bit word"
    },
    {
     "name": "WREG multiple",
     "in": "011aaaaaannnnnnn x{8} dddddddddddddddd x{8}",
     "action": "write",
     "address": "a",
     "data": "d",
     "next": "010aaaaaannnnnnn 0{8} R{16} 0{8} R{16} 0{8} 0{24}",
     "note": "n > 0: only the first register's word is modeled (the following words are zero-padded 24-bit words, not packed)"
    }
   ]
