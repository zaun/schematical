     "commit": "end"
    },
    {
     "name": "Write register command (PWDN = 0)",
     "in": "10000101 0 [DEVICE_CFG:6:0]",
     "action": "wakeup",
     "set": {
      "DEVICE_CFG.PWDN": 0
     },
     "commit": "end"
    },
