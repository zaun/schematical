    {
     "name": "Reset pattern 2",
     "in": "1{1024}",
     "action": "reset",
     "commit": "end",
     "note": "p.32 Figure 7-14: 1024 ones, reset at CS rise"
    },
    {
     "name": "No operation (read conversion data)",
     "in": "00000000 00000000",
     "action": "nop"
    },
    {
     "name": "Read register command",
     "in": "0100aaaa x{8}",
     "action": "read",
     "address": "a",
     "commit": "end",
     "next": "@ 0000aaaa",
     "note": "two-frame protocol: next frame returns register data byte + 0000b+address byte (p.41 Figure 7-23)"
    },
    {
     "name": "Write register command (RESET)",
     "in": "10000100 01011000",
     "action": "reset",
     "commit": "end",
     "note": "RESET[5:0] = 010110b with START = STOP = 0 (p.62)"
    },
    {
     "name": "Write register command (START)",
     "in": "10000100 xxxxxx10",
     "action": "start",
     "commit": "end",
     "note": "START = 1, STOP = 0; START and STOP both 1 has no effect"
    },
    {
     "name": "Write register command (STOP)",
     "in": "10000100 xxxxxx01",
     "action": "stop",
     "commit": "end"
    },
    {
     "name": "Write register command (PWDN = 1)",
     "in": "10000101 1 [DEVICE_CFG:6:0]",
