  "protocol": {
   "frame": "fixed",
   "commands": [
    {
     "name": "Write",
     "in": "0yaaaaaa d{16}",
     "action": "write",
     "address": "a",
     "data": "d",
     "when": [
      "SPICONFIG.CRC_EN=0"
     ],
     "next": "0yaaaaaa d{16}",
     "commit": "end",
     "note": "p.26 Table 6-2: R/W = 0, bit 22 don't care, A[5:0], DI[15:0]; writes take effect at SYNC rising; the next frame echoes it on SDO (daisy chain)"
    },
    {
     "name": "Read",
     "in": "1yaaaaaa x{16}",
     "action": "read",
     "address": "a",
     "when": [
      "SPICONFIG.CRC_EN=0"
     ],
     "next": "1yaaaaaa @",
     "commit": "end",
     "note": "p.26 Table 6-3: the next access cycle shifts out R/W, bit 22, A[5:0] and the register"
    },
    {
     "name": "Write (CRC frame)",
     "in": "0xaaaaaa d{16} x{8}",
     "action": "write",
     "address": "a",
     "data": "d",
     "when": [
      "SPICONFIG.CRC_EN=1"
     ],
     "next": "00aaaaaa d{16} 0{8}",
     "commit": "end",
     "note": "p.28 Table 6-4: R/W = 0, CRC-ERROR, A[5:0], DI[15:0], CRC"
    },
    {
     "name": "Read (CRC frame)",
     "in": "1xaaaaaa x{16} x{8}",
     "action": "read",
     "address": "a",
     "when": [
      "SPICONFIG.CRC_EN=1"
     ],
     "next": "10aaaaaa @ 0{8}",
     "commit": "end",
     "note": "p.28 Table 6-6: the next cycle shifts out R/W, CRC-ERROR (0), A[5:0], the register and the CRC"
    }
   ],
