    },
    {
     "name": "Soft reset (DB3 = 0)",
     "in": "xxx x{8} 0xxx 0xxx",
     "action": "reset",
     "note": "p.22: writing a low to the reset bit (DB3) while the RESET pin is high forces a device reset"
    },
    {
     "name": "Soft trigger HOLDA (DB2 = 0)",
     "in": "xxx x{8} 0xxx 10xx",
     "action": "start",
     "note": "p.22: HOLDA/B/C bits are NAND-ed with the pins (active low); DB2-DB0 low with DB3 high triggers"
