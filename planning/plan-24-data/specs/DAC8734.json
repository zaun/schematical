  "protocol": {
   "frame": "fixed",
   "align": "end",
   "out": "0",
   "commands": [
    {
     "name": "Write DAC-n input data register",
     "in": "0 000 01aa d{16}",
     "action": "write",
     "channel": "a",
     "data": "d",
     "commit": "end",
     "note": "Table 2/3: R/W = 0, A3:A0 = 0100-0111 (DAC-0..3); loaded at CS rising"
    },
    {
     "name": "NOP (command register write with NOP = 1)",
     "in": "0 000 0000 x{9} 1 x{6}",
     "action": "nop",
     "commit": "end",
     "note": "Table 4 DB6: a write with NOP = 1 has no effect (used to clock out read-back data, Figure 3)"
    },
    {
     "name": "Write reserved address",
     "in": "0 000 001x x{16}",
     "action": "nop",
     "commit": "end",
     "note": "addresses 2-3 are reserved (Table 3)"
    },
    {
     "name": "Write register",
     "in": "0 000 aaaa d{16}",
     "action": "write",
     "address": "a",
     "data": "d",
     "commit": "end",
     "note": "command, monitor, zero and gain registers (Table 3)"
    },
    {
     "name": "Read reserved address",
     "in": "1 xxx 001x x{16}",
     "action": "nop",
     "next": "0{24}",
     "commit": "end",
     "note": "reserved addresses read 0"
    },
    {
     "name": "Read DAC-0 latch (A/B = 1)",
     "in": "1 xxx 0100 x{16}",
     "action": "nop",
     "next": "0{8} [LATCH_0]",
     "when": "CMD.AB=1",
     "commit": "end",
     "note": "Table 4 A/B = 1: reading DAC-x returns the DAC latch"
    },
    {
     "name": "Read DAC-1 latch (A/B = 1)",
     "in": "1 xxx 0101 x{16}",
     "action": "nop",
     "next": "0{8} [LATCH_1]",
     "when": "CMD.AB=1",
     "commit": "end",
     "note": "Table 4 A/B = 1: reading DAC-x returns the DAC latch"
    },
    {
     "name": "Read DAC-2 latch (A/B = 1)",
     "in": "1 xxx 0110 x{16}",
     "action": "nop",
     "next": "0{8} [LATCH_2]",
     "when": "CMD.AB=1",
     "commit": "end",
     "note": "Table 4 A/B = 1: reading DAC-x returns the DAC latch"
    },
    {
     "name": "Read DAC-3 latch (A/B = 1)",
     "in": "1 xxx 0111 x{16}",
     "action": "nop",
     "next": "0{8} [LATCH_3]",
     "when": "CMD.AB=1",
     "commit": "end",
     "note": "Table 4 A/B = 1: reading DAC-x returns the DAC latch"
    },
    {
     "name": "Read register (READ command)",
     "in": "1 xxx aaaa x{16}",
     "action": "read",
     "address": "a",
     "next": "0{8} @",
     "commit": "end",
     "note": "R/W = 1: the addressed register is shifted out on SDO during the next SPI frame (p.24, Figure 43); DAC-x reads the input data register while A/B = 0"
    }
   ],
   "triggers": [
    {
     "write": "CMD.LD=1",
     "action": "update"
    },
    {
     "write": "CMD.RST=1",
     "action": "reset"
    }
   ],
   "note": "24-bit word R/W, 000, A3:A0, D15:D0 (Table 2); data latched on SCLK falling edges, the first SCLK edge after CS falls must be falling (SCLK idles high: mode 2); the word is loaded at CS rising, fewer than 24 edges are ignored, more use the last 24 (p.23); SDO valid t13 20 ns after CS falls, t11 25 ns after SCLK rising (IOVDD 1.8 V, p.11)"
  },
