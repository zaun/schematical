     "channel": "a",
     "channelMap": {
      "1": [
       0
      ],
      "0": [
       1
      ]
     },
     "data": "d",
     "when": "BUS.SDENB=1",
     "note": "data port (dual input clock mode): D13-D0 and IQ_FLAG latched on the CLK_IO rising edge; IQ_FLAG high = DACA sample (iqswap = 0)"
    },
    {
     "name": "SIF_WRITE",
     "in": "0 xx aaaaa",
     "action": "wreg",
     "address": "a",
     "count": 1,
     "when": "BUS.SDENB=0",
     "note": "instruction byte R/W = 0, N1 N0, A4-A0, then the data byte(s); only the first byte (address A) is written"
    },
    {
     "name": "SIF_READ",
     "in": "1 xx aaaaa",
     "action": "rreg",
     "address": "a",
     "count": 1,
     "reply": "@",
     "when": "BUS.SDENB=0",
     "note": "instruction byte R/W = 1: the register at A is shifted out on SDIO (3-pin mode) on SCLK falling edges"
    }
   ]
