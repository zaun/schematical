    },
    {
     "name": "RREG",
     "in": "101aaaaaa0000000 x{8}",
     "action": "read",
     "address": "a",
     "next": "@ 0{8} [R][R][R] 0{24}",
     "note": "single register: its contents are the next frame's response word"
    },
    {
     "name": "RREG",
     "in": "101aaaaaannnnnnn x{8}",
     "action": "read",
     "address": "a",
     "next": "111aaaaaannnnnnn 0{8} @ 0{8}",
     "note": "multiple registers: acknowledgment then only the first register is output (each register in its own 24-bit word is not expressible); then zeros"
    },
    {
     "name": "WREG",
     "in": "011aaaaaannnnnnn x{8} d{16} x{8}",
     "action": "write",
     "address": "a",
     "data": "d",
     "next": "010aaaaaa0000000 0{8} [R][R][R] 0{24}",
     "note": "only the first register's word is written; the acknowledgment reports one register written (mmm mmmm = 0)"
    }
