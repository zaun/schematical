     "in": "00011000 aaaaaaaa dddddddd",
     "action": "write",
     "address": "a",
     "data": "d",
     "commit": "end",
     "note": "p.23: sets the 1 bits without affecting the others; modeled as a plain write"
    },
    {
     "name": "Clear bit",
