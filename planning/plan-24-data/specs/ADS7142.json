  "protocol": {
   "frame": "fixed",
   "commands": [
    {
     "name": "Single register write (DEVICE_RESET.DEV_RST = 1)",
     "in": "00001000 00010100 xxxxxxx1",
     "action": "reset",
     "note": "p.44: writing 1 to DEV_RST resets the device (only after WKEY = 1010b; the key is not checked)"
    },
    {
     "name": "Set bit (DEVICE_RESET.DEV_RST)",
     "in": "00011000 00010100 xxxxxxx1",
     "action": "reset"
    },
    {
     "name": "Single register read",
     "in": "00010000 aaaaaaaa",
     "action": "read",
     "address": "a",
     "next": "@",
     "note": "p.28-29 Figures 49-50: opcode 10h + address, then a read frame returns the register (repeated with more clocks); later read frames return ADC data"
    },
    {
     "name": "Reading a continuous block of registers",
     "in": "00110000 aaaaaaaa",
     "action": "read",
     "address": "a",
     "next": "@",
     "note": "opcode 30h: successive registers follow; modeled as the first register only"
    },
    {
     "name": "Single register write",
     "in": "00001000 aaaaaaaa dddddddd",
     "action": "write",
     "address": "a",
     "data": "d"
    },
    {
     "name": "Writing a continuous block of registers",
     "in": "00101000 aaaaaaaa dddddddd",
     "action": "write",
     "address": "a",
     "data": "d",
     "note": "opcode 28h: further bytes go to ascending addresses; modeled as the first register only"
    },
    {
     "name": "Set bit",
     "in": "00011000 aaaaaaaa dddddddd",
     "action": "write",
     "address": "a",
     "data": "d",
     "note": "opcode 18h sets the 1 bits; modeled as a plain write"
    },
    {
     "name": "Clear bit",
     "in": "00100000 aaaaaaaa xxxxxxxx",
     "action": "nop",
     "note": "opcode 20h clears the 1 bits; not modeled (read-modify-write)"
    }
   ],
   "read": "R{12} 0000",
   "generalCall": "reset"
  },
