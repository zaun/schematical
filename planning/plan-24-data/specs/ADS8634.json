  "protocol": {
   "frame": "fixed",
   "out": "0 [CH:1:0] 0 R{12}",
   "idle": "z",
   "commands": [
    {
     "name": "CONTINUE",
     "in": "0{16}",
     "action": "nop",
     "when": "PAGE.PAGE_ADDR=0",
     "note": "DIN held low: continue in the last selected mode (p.50, p.54)"
    },
    {
     "name": "PAGE_WRITE",
     "in": "1111111 0 dddddddd",
     "action": "write",
     "register": "PAGE",
     "data": "d",
     "commit": "end"
    },
    {
     "name": "PAGE_READ",
     "in": "1111111 1",
     "action": "rreg",
     "address": 127,
     "reply": "@"
    },
    {
     "name": "MANUAL_POWERDOWN",
     "in": "0000100 0 [MANUAL:7:4] 111 [MANUAL:0:0]",
     "action": "powerdown",
     "set": {
      "MANUAL.RANGE": 7
     },
     "when": "PAGE.PAGE_ADDR=0",
     "note": "range 111: power-down after the 16th SCLK falling edge (p.30, Table 6)"
    },
    {
     "name": "AUTO_POWERDOWN",
     "in": "0000101 0 [AUTO:7:4] 111 [AUTO:0:0]",
     "action": "powerdown",
     "set": {
      "AUTO.RANGE": 7
     },
     "when": "PAGE.PAGE_ADDR=0"
    },
    {
     "name": "MANUAL",
     "in": "0000100 0 dddddddd",
     "action": "write",
     "register": "MANUAL",
     "data": "d",
     "commit": "end",
     "then": [
      "wakeup"
     ],
     "when": "PAGE.PAGE_ADDR=0",
     "note": "a manual/auto write with range 000-110 is the power-up command (p.31, Table 7)"
    },
    {
     "name": "AUTO",
     "in": "0000101 0 dddddddd",
     "action": "write",
     "register": "AUTO",
     "data": "d",
     "commit": "end",
     "then": [
      "wakeup"
     ],
     "when": "PAGE.PAGE_ADDR=0"
    },
    {
     "name": "RESET_DEVICE",
     "in": "0000001 0 0000000 1",
     "action": "reset",
     "when": "PAGE.PAGE_ADDR=0",
     "note": "software reset after the 16th SCLK falling edge (p.54)"
    },
    {
     "name": "WRITE",
     "in": "aaaaaaa 0 dddddddd",
     "action": "write",
     "address": "a",
     "data": "d",
     "commit": "end",
     "when": "PAGE.PAGE_ADDR=0"
    },
    {
     "name": "WRITE_P1",
     "in": "aaaaaaa 0 dddddddd",
     "action": "write",
     "address": "a",
     "space": "page1",
     "data": "d",
     "commit": "end",
     "when": "PAGE.PAGE_ADDR=1"
    },
    {
     "name": "READ",
     "in": "aaaaaaa 1",
     "action": "rreg",
     "address": "a",
     "reply": "@",
     "when": "PAGE.PAGE_ADDR=0",
