{
  "boards": [
    {
      "id": "isa8",
      "title": "ISA 8-bit",
      "group": "PC Cards",
      "notes": "IBM PC/XT Technical Reference. Fingers 0.060\" wide at 0.100\" pitch, the full 0.300\" tab height; A on the component side, B on the solder side, A1/B1 nearest the bracket. The tab starts 0.705\" from the bracket edge. Keep-clear 0.145\" past the tab.",
      "vars": { "edge": "height - 0.3in", "c": "0.06in" },
      "height": "4.2in",
      "length": { "default": "6.875in", "min": "ceil(4.04in)", "max": "13.13in" },
      "outline": [
        [0, 0], ["width", 0], ["width", "edge"],
        ["3.895in", "edge"], ["3.895in", "height - c"], ["3.895in - c", "height"],
        ["0.705in + c", "height"], ["0.705in", "height - c"], ["0.705in", "edge"],
        [0, "edge"]
      ],
      "pins": [
        { "name": "A{n}", "from": 1, "to": 31,
          "finger": { "x": "0.8in + (n - 1) * 0.1in", "width": "0.06in", "top": "edge", "bottom": "height", "side": "top" } },
        { "name": "B{n}", "from": 1, "to": 31,
          "finger": { "x": "0.8in + (n - 1) * 0.1in", "width": "0.06in", "top": "edge", "bottom": "height", "side": "bottom" } }
      ]
    },
    {
      "id": "isa16",
      "title": "ISA 16-bit",
      "group": "PC Cards",
      "notes": "IBM PC/AT and the EISA specification. As ISA 8-bit, plus C (component side) and D (solder side) after a 0.215\" key notch. Keep-clear 2.250\" past the notch's datum.",
      "vars": { "edge": "height - 0.3in", "c": "0.06in" },
      "height": "4.8in",
      "length": { "default": "6.875in", "min": "ceil(6.145in)", "max": "13.13in" },
      "outline": [
        [0, 0], ["width", 0], ["width", "edge"],
        ["5.99in", "edge"], ["5.99in", "height - c"], ["5.99in - c", "height"],
        ["4.11in + c", "height"], ["4.11in", "height - c"], ["4.11in", "edge"],
        ["3.895in", "edge"], ["3.895in", "height - c"], ["3.895in - c", "height"],
        ["0.705in + c", "height"], ["0.705in", "height - c"], ["0.705in", "edge"],
        [0, "edge"]
      ],
      "pins": [
        { "name": "A{n}", "from": 1, "to": 31,
          "finger": { "x": "0.8in + (n - 1) * 0.1in", "width": "0.06in", "top": "edge", "bottom": "height", "side": "top" } },
        { "name": "B{n}", "from": 1, "to": 31,
          "finger": { "x": "0.8in + (n - 1) * 0.1in", "width": "0.06in", "top": "edge", "bottom": "height", "side": "bottom" } },
        { "name": "C{n}", "from": 1, "to": 18,
          "finger": { "x": "4.2in + (n - 1) * 0.1in", "width": "0.06in", "top": "edge", "bottom": "height", "side": "top" } },
        { "name": "D{n}", "from": 1, "to": 18,
          "finger": { "x": "4.2in + (n - 1) * 0.1in", "width": "0.06in", "top": "edge", "bottom": "height", "side": "bottom" } }
      ]
    },
    {
      "id": "pci",
      "title": "PCI (32-bit Universal)",
      "group": "PC Cards",
      "notes": "PCI Local Bus Specification 2.2 / 3.0, keyed for 3.3 V and 5 V slots. Fingers 1.016 mm wide at 1.27 mm pitch, 2.413 to 6.89 mm above the card's bottom; B on the component side, A on the solder side, position 1 nearest the bracket. Positions 12-13 and 50-51 are key notches with no fingers. The tab reaches 12.07 mm below the card edge, and a 15 mm foot at the bracket end as far. The notch depth isn't dimensioned in the spec; 9.4 mm is read off its drawing.",
      "vars": { "edge": "height - 12.07", "c": 0.381, "half": "1.854 / 2" },
      "height": 106.68,
      "length": { "default": 174.63, "min": 122, "max": 312 },
      "outline": [
        [0, 0], ["width", 0], ["width", "edge"],
        [119.91, "edge"], [119.91, "height - c"], ["119.91 - c", "height"],
        ["104.47 + half", "height"], ["104.47 + half", "height - 9.4"], ["104.47 - half", "height - 9.4"], ["104.47 - half", "height"],
        ["56.21 + half", "height"], ["56.21 + half", "height - 9.4"], ["56.21 - half", "height - 9.4"], ["56.21 - half", "height"],
        ["40.77 + c", "height"], [40.77, "height - c"], [40.77, "edge"],
        [15, "edge"], [15, "height - c"], ["15 - c", "height"], [0, "height"]
      ],
      "pins": [
        { "name": "B{n}", "from": 1, "to": 62, "where": "!(n in [12, 13, 50, 51])",
          "finger": { "x": "41.605 + (n - 1) * 1.27", "width": 1.016, "top": "height - 6.89", "bottom": "height - 2.413", "side": "top" } },
        { "name": "A{n}", "from": 1, "to": 62, "where": "!(n in [12, 13, 50, 51])",
          "finger": { "x": "41.605 + (n - 1) * 1.27", "width": 1.016, "top": "height - 6.89", "bottom": "height - 2.413", "side": "bottom" } }
      ]
    },
    {
      "id": "pcie",
      "title": "PCI Express",
      "group": "PC Cards",
      "notes": "CEM 2.0 / 4.0: full height 111.15 mm or low profile 68.90 mm, the bracket at the left. Fingers at 1.0 mm pitch, 0.70 mm wide, tops 5.60 mm above the edge, from 1.69 mm (the presence-detect pins A1, B17, B31, B48, B81 from 2.40 mm). Side B is the component side, A behind it; B1 nearest the bracket. A 1.90 mm key with a round end between pins 11 and 12, 57.15 mm from the rear edge. The tab reaches 12.75 mm below the card; at the bracket end a foot (to 15 mm) and the block that keeps it out of a PCI slot reach 8.25 mm.",
      "options": [
        { "id": "lanes", "title": "Lanes", "default": 1, "choices": [
          { "value": 1, "title": "x1", "vars": { "pins": 18, "tabEnd": 65.30 } },
          { "value": 4, "title": "x4", "vars": { "pins": 32, "tabEnd": 79.30 } },
          { "value": 8, "title": "x8", "vars": { "pins": 49, "tabEnd": 96.30 } },
          { "value": 16, "title": "x16", "vars": { "pins": 82, "tabEnd": 129.30 } }
        ] },
        { "id": "lowProfile", "title": "Bracket", "onBus": false, "choices": [
          { "value": false, "title": "Full height" },
          { "value": true, "title": "Low profile" }
        ] }
      ],
      "vars": { "edge": "height - 12.75", "foot": "edge + 8.25" },
      "height": "lowProfile ? 68.90 : 111.15",
      "length": { "default": 167.65, "min": "ceil(tabEnd + 5)", "max": "lowProfile ? 167.65 : 312" },
      "outline": [
        [0, 0], ["width", 0], ["width", "edge"],
        ["tabEnd", "edge"], ["tabEnd", "height - 0.5"], ["tabEnd - 0.5", "height"],
        [58.10, "height"],
        { "arc": [57.15, "height - 8.40 + 0.95"], "radius": 0.95, "from": 0, "to": -180 },
        [56.20, "height"],
        [45.5, "height"], [45, "height - 0.5"], [45, "edge"],
        [41.35, "edge"], [41.35, "foot"], [33.35, "foot"], [33.35, "edge"],
        [15, "edge"], [15, "foot"], [0, "foot"]
      ],
      "pins": [
        { "name": "B{n}", "from": 1, "to": "pins",
          "finger": { "x": "45.65 + (n - 1) + (n >= 12 ? 2 : 0)", "width": 0.70, "top": "height - 5.60",
                      "bottom": "height - (n in [17, 31, 48, 81] ? 2.40 : 1.69)", "side": "top" } },
        { "name": "A{n}", "from": 1, "to": "pins",
          "finger": { "x": "45.65 + (n - 1) + (n >= 12 ? 2 : 0)", "width": 0.70, "top": "height - 5.60",
                      "bottom": "height - (n == 1 ? 2.40 : 1.69)", "side": "bottom" } }
      ]
    },
    {
      "id": "m2",
      "title": "M.2",
      "group": "Modules",
      "notes": "PCI Express M.2 Specification 1.0, Type 22: 22 mm wide and `length` long, contacts along the 22 mm end on a 19.85 mm strip 4 mm deep. 75 places at 0.5 mm pitch, odd pins on top (pin 1 at the right) and even ones on the bottom, offset by 0.25 mm; 0.35 mm wide, from 0.3 mm to 2.0 mm (top) or 2.5 mm (bottom) from the edge. Each key is a 1.2 mm slot 3.5 mm deep with a round end, and drops its 8 pins. A 3.5 mm half-circle in the far end takes the screw.",
      "options": [
        { "id": "length", "title": "Length", "style": "menu", "onBus": false, "default": 80, "choices": [
          { "value": 30, "title": "2230" }, { "value": 42, "title": "2242" }, { "value": 60, "title": "2260" },
          { "value": 80, "title": "2280" }, { "value": 110, "title": "22110" }
        ] },
        { "id": "key", "title": "Key", "default": "m", "choices": [
          { "value": "b", "title": "B" }, { "value": "m", "title": "M" }, { "value": "bm", "title": "B+M" },
          { "value": "e", "title": "E" }, { "value": "ae", "title": "A+E" }
        ] }
      ],
      "vars": {
        "hasA": "key == 'ae'", "hasB": "key == 'b' || key == 'bm'",
        "hasE": "key == 'e' || key == 'ae'", "hasM": "key == 'm' || key == 'bm'"
      },
      "height": "length",
      "width": 22,
      "outline": [
        [0, 0],
        { "arc": [11, 0], "radius": 1.75, "from": 180, "to": 0, "steps": 8 },
        [22, 0], [22, "height - 4"], [21.425, "height - 4"],
        { "arc": [21.425, "height - 3.5"], "radius": 0.5, "from": -90, "to": -180, "steps": 4, "skipFirst": true },
        [20.925, "height"],
        { "when": "hasA", "then": [
          [18.225, "height"], { "arc": [17.625, "height - 2.9"], "radius": 0.6, "from": 0, "to": -180 }, [17.025, "height"] ] },
        { "when": "hasB", "then": [
          [17.225, "height"], { "arc": [16.625, "height - 2.9"], "radius": 0.6, "from": 0, "to": -180 }, [16.025, "height"] ] },
        { "when": "hasE", "then": [
          [14.225, "height"], { "arc": [13.625, "height - 2.9"], "radius": 0.6, "from": 0, "to": -180 }, [13.025, "height"] ] },
        { "when": "hasM", "then": [
          [5.475, "height"], { "arc": [4.875, "height - 2.9"], "radius": 0.6, "from": 0, "to": -180 }, [4.275, "height"] ] },
        [1.075, "height"],
        { "arc": [0.575, "height - 3.5"], "radius": 0.5, "from": 0, "to": -90, "steps": 4 },
        [0, "height - 4"]
      ],
      "pins": [
        { "from": 1, "to": 75, "step": 2, "where": "!((hasA && n >= 8 && n <= 15) || (hasB && n >= 12 && n <= 19) || (hasE && n >= 24 && n <= 31) || (hasM && n >= 59 && n <= 66))",
          "finger": { "x": "11 + (38 - n) * 0.25", "width": 0.35, "top": "height - 2.0", "bottom": "height - 0.3", "side": "top" } },
        { "from": 2, "to": 74, "step": 2, "where": "!((hasA && n >= 8 && n <= 15) || (hasB && n >= 12 && n <= 19) || (hasE && n >= 24 && n <= 31) || (hasM && n >= 59 && n <= 66))",
          "finger": { "x": "11 + (38 - n) * 0.25", "width": 0.35, "top": "height - 2.5", "bottom": "height - 0.3", "side": "bottom" } }
      ]
    },
    {
      "id": "miniPCIe",
      "title": "Mini PCIe",
      "group": "Modules",
      "notes": "PCI Express Mini Card (Mini CEM 1.2): 30 mm wide, 50.95 mm long (26.80 half size), contacts along a 25.70 mm tab 3.20 mm deep. 52 pins at 0.8 mm pitch, 0.60 x 2.55 mm, 0.25 mm above the edge: odd pins on top with pin 1 at the left, each even pin on the bottom 0.40 mm right of the odd one before it. A 1.50 mm key with a round end, 4.00 mm deep, between pins 15 and 17, 11.15 mm from the left.",
      "options": [
        { "id": "halfSize", "title": "Size", "onBus": false, "choices": [
          { "value": false, "title": "Full" }, { "value": true, "title": "Half" }
        ] }
      ],
      "height": "halfSize ? 26.80 : 50.95",
      "width": 30,
      "outline": [
        [0, 0], [30, 0], [30, "height - 3.20"], [27.85, "height - 3.20"], [27.85, "height"],
        [11.9, "height"],
        { "arc": [11.15, "height - 4.00 + 0.75"], "radius": 0.75, "from": 0, "to": -180 },
        [10.4, "height"], [2.15, "height"], [2.15, "height - 3.20"], [0, "height - 3.20"]
      ],
      "pins": [
        { "from": 1, "to": 51, "step": 2, "let": { "x": "n <= 15 ? 3.20 + (n - 1) / 2 * 0.8 : 12.80 + (n - 17) / 2 * 0.8" },
          "finger": { "x": "x", "width": 0.60, "top": "height - 2.80", "bottom": "height - 0.25", "side": "top" } },
        { "name": "{n + 1}", "from": 1, "to": 51, "step": 2, "let": { "x": "n <= 15 ? 3.20 + (n - 1) / 2 * 0.8 : 12.80 + (n - 17) / 2 * 0.8" },
          "finger": { "x": "x + 0.40", "width": 0.60, "top": "height - 2.80", "bottom": "height - 0.25", "side": "bottom" } }
      ]
    },
    {
      "id": "sodimm",
      "title": "SO-DIMM",
      "group": "Modules",
      "notes": "Micron and socket drawings; JEDEC MO-268, MO-310, MO-337. Odd pins on the front, each even pin behind the odd one before it, half a pitch to the right. DDR3: 67.6 x 30 mm, 204 pins at 0.6 mm; DDR4: 69.6 x 30, 260 at 0.5; DDR5: 69.6 x 30, 262 at 0.5. A 1 mm round-ended key 4 mm deep; notches in both short sides 18-22 mm up (half-round on DDR3).",
      "options": [
        { "id": "memory", "title": "Memory", "default": "ddr4", "choices": [
          { "value": "ddr3", "title": "DDR3", "vars": { "w": 67.6, "pitch": 0.6, "padWidth": 0.45, "padBottom": 0, "padTop": 2.55,
            "pairs": 102, "firstAfterKey": 37, "start": 2.15, "restart": 26.15, "key": 24.8, "tc": 0.6, "bc": 0.6 } },
          { "value": "ddr4", "title": "DDR4", "vars": { "w": 69.6, "pitch": 0.5, "padWidth": 0.35, "padBottom": 0.3, "padTop": 2.55,
            "pairs": 130, "firstAfterKey": 73, "start": 1.425, "restart": 39.425, "key": 38.3, "tc": 0.6, "bc": 0.6 } },
          { "value": "ddr5", "title": "DDR5", "vars": { "w": 69.6, "pitch": 0.5, "padWidth": 0.35, "padBottom": 0.3, "padTop": 2.85,
            "pairs": 131, "firstAfterKey": 64, "start": 1.425, "restart": 34.425, "key": 33.55, "tc": 0, "bc": 0.7 } }
        ] }
      ],
      "height": 30,
      "width": "w",
      "outline": [
        ["tc", 0], ["w - tc", 0],
        { "when": "tc > 0", "then": [["w", "tc"]] },
        { "when": "memory == 'ddr3'", "then": [{ "arc": ["w", "height - 20"], "radius": 2, "from": -90, "to": -270 }] },
        { "when": "memory != 'ddr3'", "then": [["w", "height - 22"], ["w - 1.75", "height - 22"], ["w - 1.75", "height - 18"], ["w", "height - 18"]] },
        ["w", "height - bc"],
        { "when": "bc > 0", "then": [["w - bc", "height"]] },
        ["key + 0.5", "height"],
        { "arc": ["key", "height - 4 + 0.5"], "radius": 0.5, "from": 0, "to": -180 },
        ["key - 0.5", "height"],
        { "when": "bc > 0", "then": [["bc", "height"]] },
        [0, "height - bc"],
        { "when": "memory != 'ddr3'", "then": [[0, "height - 18"], [1.75, "height - 18"], [1.75, "height - 22"], [0, "height - 22"]] },
        { "when": "memory == 'ddr3'", "then": [{ "arc": [0, "height - 20"], "radius": 2, "from": 90, "to": -90 }] },
        { "when": "tc > 0", "then": [[0, "tc"]] }
      ],
      "pins": [
        { "name": "{2 * n + 1}", "from": 0, "to": "pairs - 1",
          "let": { "x": "n + 1 < firstAfterKey ? start + n * pitch : restart + (n + 1 - firstAfterKey) * pitch" },
          "finger": { "x": "x", "width": "padWidth", "top": "height - padTop", "bottom": "height - padBottom", "side": "top" } },
        { "name": "{2 * n + 2}", "from": 0, "to": "pairs - 1",
          "let": { "x": "n + 1 < firstAfterKey ? start + n * pitch : restart + (n + 1 - firstAfterKey) * pitch" },
          "finger": { "x": "x + pitch / 2", "width": "padWidth", "top": "height - padTop", "bottom": "height - padBottom", "side": "bottom" } }
      ]
    },
    {
      "id": "dimm",
      "title": "DIMM",
      "group": "Modules",
      "notes": "Micron, Samsung, Innodisk, Advantech drawings: 133.35 mm long, pins 1... on the front from the left and the back's behind them (121 behind 1 on DDR3, 145 on DDR4/DDR5). DDR3: 30 mm high, 240 pins at 1.0 mm, a straight edge. DDR4/DDR5: 31.25 mm, 288 pins at 0.85 mm on an edge 0.5 mm higher at the ends, every finger's top level and its bottom 0.25 mm above the edge under it. Two notches in each short side. A DDR5 RDIMM's key sits further right than a UDIMM's.",
      "options": [
        { "id": "memory", "title": "Memory", "default": "ddr4", "choices": [
          { "value": "ddr3", "title": "DDR3", "vars": { "h": 30, "pitch": 1.0, "padWidth": 0.8, "perSide": 120, "split": 49,
            "start": 5.175, "restart": 57.175, "key": 54.675, "keyWidth": 1.52, "keyDepth": 3.81 } },
          { "value": "ddr4", "title": "DDR4", "vars": { "h": 31.25, "pitch": 0.85, "padWidth": 0.6, "perSide": 144, "split": 78,
            "start": 3.35, "restart": 73.90, "key": 72.25, "keyWidth": 1.5, "keyDepth": 3.85 } },
          { "value": "ddr5", "title": "DDR5", "vars": { "h": 31.25, "pitch": 0.85, "padWidth": 0.6, "perSide": 144, "split": 76,
            "start": 3.35, "restart": 72.20, "key": "registered ? 70.55 : 68.10", "keyWidth": 1.5, "keyDepth": 3.85 } }
        ] },
        { "id": "registered", "title": "Registered (RDIMM)", "style": "toggle", "onBus": false, "when": "memory == 'ddr5'",
          "help": "A DDR5 RDIMM's key sits 2.45 mm further right than an unbuffered DIMM's" }
      ],
      "vars": { "kh": "keyWidth / 2" },
      "height": "h",
      "width": 133.35,
      "outline": [
        { "when": "memory == 'ddr3'", "then": [
          [0.6, 0], ["width - 0.6", 0], ["width", 0.6],
          ["width", "height - 24.85"], ["width - 1.35", "height - 24.85"], ["width - 1.35", "height - 21.75"], ["width", "height - 21.75"],
          ["width", "height - 18.8"], ["width - 2.2", "height - 18.8"], ["width - 2.2", "height - 15.8"], ["width", "height - 15.8"],
          ["width", "height - 11"], ["width - 2.2", "height - 11"], ["width - 2.2", "height - 8"], ["width", "height - 8"],
          ["width", "height - 0.6"], ["width - 0.6", "height"],
          ["key + kh", "height"], { "arc": ["key", "height - keyDepth + kh"], "radius": "kh", "from": 0, "to": -180 }, ["key - kh", "height"],
          [0.6, "height"], [0, "height - 0.6"],
          [0, "height - 8"], [2.2, "height - 8"], [2.2, "height - 11"], [0, "height - 11"],
          [0, "height - 15.8"], [2.2, "height - 15.8"], [2.2, "height - 18.8"], [0, "height - 18.8"],
          [0, "height - 21.75"], [1.35, "height - 21.75"], [1.35, "height - 24.85"], [0, "height - 24.85"],
          [0, 0.6]
        ] },
        { "when": "memory == 'ddr4'", "then": [
          [1.25, 0], ["width - 1.25", 0], ["width", 1.25],
          ["width", "height - 17.6"], ["width - 2.2", "height - 17.6"], ["width - 2.2", "height - 14.6"], ["width", "height - 14.6"],
          ["width", "height - 11"], ["width - 2.2", "height - 11"], ["width - 2.2", "height - 8"], ["width", "height - 8"],
          ["width", "height - 0.5"],
          [106.625, "height - 0.5"], [97.275, "height"],
          ["key + kh", "height"], { "arc": ["key", "height - keyDepth + kh"], "radius": "kh", "from": 0, "to": -180 }, ["key - kh", "height"],
          [42.025, "height"], [32.675, "height - 0.5"],
          [0, "height - 0.5"],
          [0, "height - 8"], [2.2, "height - 8"], [2.2, "height - 11"], [0, "height - 11"],
          [0, "height - 14.6"], [2.2, "height - 14.6"], [2.2, "height - 17.6"], [0, "height - 17.6"],
          [0, 1.25]
        ] },
        { "when": "memory == 'ddr5'", "then": [
          [0, 0], ["width", 0],
          ["width", "height - 17.6"], ["width - 2.1", "height - 17.6"], ["width - 2.1", "height - 14.6"], ["width", "height - 14.6"],
          ["width", "height - 11"], ["width - 2.1", "height - 11"], ["width - 2.1", "height - 8"], ["width", "height - 8"],
          ["width", "height - 0.5 - 0.8"], ["width - 0.8", "height - 0.5"],
          [110.87, "height - 0.5"], [101.52, "height"],
          ["key + kh", "height"], { "arc": ["key", "height - keyDepth + kh"], "radius": "kh", "from": 0, "to": -180 }, ["key - kh", "height"],
          [45.43, "height"], [36.08, "height - 0.5"],
          [0.8, "height - 0.5"], [0, "height - 0.5 - 0.8"],
          [0, "height - 8"], [2.1, "height - 8"], [2.1, "height - 11"], [0, "height - 11"],
          [0, "height - 14.6"], [2.1, "height - 14.6"], [2.1, "height - 17.6"], [0, "height - 17.6"]
        ] }
      ],
      "pins": [
        { "from": 1, "to": "perSide",
          "let": {
            "x": "n < split ? start + (n - 1) * pitch : restart + (n - split) * pitch",
            "lift": "memory == 'ddr3' ? 0 : memory == 'ddr4' ? interp(x, 0, 0.5, 32.675, 0.5, 42.025, 0, 97.275, 0, 106.625, 0.5, 133.35, 0.5) + 0.25 : interp(x, 0, 0.5, 36.08, 0.5, 45.43, 0, 101.52, 0, 110.87, 0.5, 133.35, 0.5) + 0.25"
          },
          "finger": { "x": "x", "width": "padWidth", "top": "height - (memory == 'ddr3' ? 2.5 : 2.85)", "bottom": "height - lift", "side": "top" } },
        { "name": "{n + perSide}", "from": 1, "to": "perSide",
          "let": {
            "x": "n < split ? start + (n - 1) * pitch : restart + (n - split) * pitch",
