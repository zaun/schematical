 {"label": "slide switch: a state lists a name", "file": "switch.json", "device": "slide_dpdt_onoffon_125v_standard",
  "set": {"states.0.0": "C1"}, "want": "a state lists contact numbers"},
 {"label": "slide switch: a state lists 1.5", "file": "switch.json", "device": "slide_dpdt_onoffon_125v_standard",
  "set": {"states.0.0": 1.5}, "want": "a state lists contact numbers"},

