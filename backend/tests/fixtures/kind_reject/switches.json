 {"label": "switch: a contact that is no pair", "file": "switch.json", "device": "te_gds_02",
  "set": {"contacts.0": ["1A"]}, "want": "a contact is [pin name, pin name]"},
 {"label": "switch: no actuator", "file": "switch.json", "device": "te_gds_02",
  "set": {"actuator": null}, "want": "missing \"actuator\""},
 {"label": "switch: contacts empty", "file": "switch.json", "device": "te_gds_02",
