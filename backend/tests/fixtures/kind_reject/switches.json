 {"label": "slide switch: nine contacts", "file": "switch.json", "device": "slide_dpdt_onoffon_125v_standard",
  "set": {"contacts": [["C1", "A1"], ["C1", "B1"], ["C2", "A2"], ["C2", "B2"], ["A1", "B1"],
