[
 {"label": "relay: no type", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"type": null}, "want": "missing \"type\""},
 {"label": "relay: latching not a bool", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"latching": "yes"}, "want": "\"latching\" must be true or false"},
 {"label": "relay: a coil that is no object", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"coils.0": "A1"}, "want": "a coil is {\"a\": <pin name>, \"b\": <pin name>}"},
 {"label": "relay: a coil without b", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"coils.0.b": null}, "want": "missing \"b\""},
 {"label": "relay: a coil of one pin", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"coils.0.b": "A1"}, "want": "a coil's a and b must be different pins"},
 {"label": "relay: contacts empty", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"contacts": []}, "want": "\"contacts\" must have 1 to 8 entries"},
 {"label": "relay: a contact that is no object", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"contacts.0": "COM"}, "want": "a contact is {\"common\", \"no\", \"nc\"}"},
 {"label": "relay: a contact without common", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"contacts.0.common": null}, "want": "missing \"common\""},
 {"label": "relay: no not a string", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"contacts.0.no": 5}, "want": "\"no\" must be a string"},
 {"label": "relay: nc not a string", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"contacts.0.nc": 5}, "want": "\"nc\" must be a string"},
 {"label": "relay: common and no one pin", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"contacts.0.no": "COM"}, "want": "the names of a contact must be different pins"},
 {"label": "relay: coil on a latching relay", "file": "relay.json",
