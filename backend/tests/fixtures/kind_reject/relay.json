 {"label": "relay: contactVolts 0", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"parts.0.contactVolts": 0}, "want": "\"contactVolts\" must be above 0 and at most 100000"},
 {"label": "relay: operateMs 0", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"parts.0.operateMs": 0}, "want": "\"operateMs\" must be above 0 and at most 10000"},
 {"label": "relay: releaseMs 0", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"parts.0.releaseMs": 0}, "want": "\"releaseMs\" must be above 0 and at most 10000"},
