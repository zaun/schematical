 {"label": "relay: no names no pin", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
  "set": {"contacts.0.no": "N9", "pinouts.a1-no-com-a2-nc.1": {"number": 2, "name": "Z2", "role": "nc"}}, "want": "no pin named \"N9\""},
 {"label": "relay: contactAmps 0", "file": "relay.json", "device": "relay_auto_spdt_a1-no-com-a2-nc",
