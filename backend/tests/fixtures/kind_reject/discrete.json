[
 {"label": "resistor: resistors empty", "file": "resistor.json", "device": "chip-jumper-two-pin-lt-1k",
  "set": {"resistors": []}, "want": "\"resistors\" must be a non-empty array of {\"a\", \"b\"}"},
 {"label": "resistor: a pair that is no object", "file": "resistor.json", "device": "chip-jumper-two-pin-lt-1k",
  "set": {"resistors.0": "1-2"}, "want": "a resistor is {\"a\": <pin name>, \"b\": <pin name>}"},
 {"label": "resistor: a pair without b", "file": "resistor.json", "device": "chip-jumper-two-pin-lt-1k",
  "set": {"resistors.0.b": null}, "want": "missing \"b\""},
 {"label": "resistor: a names no pin", "file": "resistor.json", "device": "chip-jumper-two-pin-lt-1k",
  "set": {"resistors.0.a": "9"}, "want": "no pin named \"9\""},
 {"label": "resistor: b names no pin", "file": "resistor.json", "device": "chip-jumper-two-pin-lt-1k",
  "set": {"resistors.0.b": "9"}, "want": "no pin named \"9\""},
 {"label": "resistor: an NC pin is in no resistor and no tie", "file": "resistor.json",
  "device": "chip-jumper-two-pin-lt-1k", "loads": true,
  "set": {"id": "r68-res-nc", "parts.0.name": "R68-RES-NC", "parts.0.footprint": "SOT23-3",
          "pinouts.two-pin.2": {"number": 3, "name": "NC", "role": "nc"}},
  "want": "3:NC:nc"},

 {"label": "diode: no type", "file": "diode.json", "device": "fast-1",
  "set": {"type": null}, "want": "missing \"type\""},
 {"label": "diode: no diodes", "file": "diode.json", "device": "fast-1",
  "set": {"diodes": null}, "want": "missing \"diodes\""},
 {"label": "diode: a pair that is no object", "file": "diode.json", "device": "fast-1",
  "set": {"diodes.0": ["A", "K"]}, "want": "a diode is {\"anode\": <pin name>, \"cathode\": <pin name>}"},
 {"label": "diode: a pair without cathode", "file": "diode.json", "device": "fast-1",
  "set": {"diodes.0.cathode": null}, "want": "missing \"cathode\""},
 {"label": "diode: anode and cathode one name", "file": "diode.json", "device": "fast-1",
  "set": {"diodes.0.cathode": "A"}, "want": "a diode's anode and cathode must be different pins"},
 {"label": "diode: anode names no pin", "file": "diode.json", "device": "fast-1",
  "set": {"diodes.0.anode": "X"}, "want": "no pin named \"X\""},
 {"label": "zener: no vz", "file": "diode.json", "device": "zener-1",
  "set": {"parts.0.vz": null}, "want": "missing \"vz\""},
 {"label": "zener: no pd", "file": "diode.json", "device": "zener-1",
  "set": {"parts.0.pd": null}, "want": "missing \"pd\""}
]
