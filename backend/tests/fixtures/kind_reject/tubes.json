  "text": "{\"format\":\"schematical-parts\",\"version\":1,\"kind\":\"dekatron\",\"devices\":[{\"id\":\"r68-dk\",\"function\":\"Dekatron\",\"description\":\"x\",\"drawer\":[],\"anode\":\"A\",\"cathodes\":{\"K0\":[0],\"K\":[1,2,3,4],\"K\":[5,6,7,8,9]},\"guides\":[\"G1\",\"G2\"],\"drive\":\"double\",\"color\":\"Orange\",\"size\":\"29.5 mm\",\"view\":\"end\",\"strike\":350,\"sustain\":196,\"current\":[0.25,0.55],\"rate\":4000,\"pinouts\":{\"base\":[{\"number\":1,\"name\":\"K\",\"role\":\"input\"},{\"number\":2,\"name\":\"NC\",\"role\":\"nc\"},{\"number\":3,\"name\":\"G1\",\"role\":\"input\"},{\"number\":4,\"name\":\"A\",\"role\":\"input\"},{\"number\":5,\"name\":\"G2\",\"role\":\"input\"},{\"number\":6,\"name\":\"NC\",\"role\":\"nc\"},{\"number\":7,\"name\":\"K0\",\"role\":\"input\"},{\"number\":8,\"name\":\"NC\",\"role\":\"nc\"}]},\"parts\":[{\"name\":\"R68-DK\",\"package\":\"Tube\",\"pinout\":\"base\",\"footprint\":\"TUBE-RSH5-1\"}]}]}",
